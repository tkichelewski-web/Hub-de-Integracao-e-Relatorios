    estrutura.diretorias.map(d => `<option value="${d.id}">${d.nome}</option>`).join('');
  onSafraChange();
}

function onSafraChange() {
  const safra = safrasData.find(s => s.id === parseInt(document.getElementById('f-safra').value));
  const meses = getMesesSafra(safra);
  const hoje = new Date();
  const atual = hoje.getFullYear() + '-' + String(hoje.getMonth() + 1).padStart(2, '0');
  const selM = document.getElementById('f-mes');
  selM.innerHTML = meses.map(m => `<option value="${m.val}">${m.nome}</option>`).join('');
  // Padrão: mês atual se estiver na safra; senão o último mês da safra que já passou
  const passados = meses.filter(m => m.val <= atual);
  if (meses.find(m => m.val === atual)) selM.value = atual;
  else if (passados.length) selM.value = passados[passados.length - 1].val;
  atualizarResumoFiltro();
}

let _resumoSeq = 0;
async function atualizarResumoFiltro() {
  const box = document.getElementById('resumo-filtro');
  const mes = document.getElementById('f-mes').value;
  if (!mes) { box.textContent = 'Selecione safra e mês.'; return; }
  const dirId = parseInt(document.getElementById('f-dir').value) || 0;
  const seq = ++_resumoSeq;
  box.innerHTML = '<span class="spinner" style="color:var(--verde)"></span> Consultando lançamentos...';
  const { data, error } = await sbSafe(() =>
    sb.from('lancamentos').select('id,gerencia_id,indice_prevencao,gerencias(diretoria_id)')
      .or(`mes.eq.${mes},periodo.eq.${mes}`)
  );
  if (seq !== _resumoSeq) return; // o usuário já trocou o filtro
  if (error) { box.textContent = 'Não foi possível consultar o banco: ' + error.message; return; }
  let lista = (data || []).filter(l => l.gerencias);
  if (dirId) lista = lista.filter(l => l.gerencias.diretoria_id === dirId);
  const nGer = new Set(lista.map(l => l.gerencia_id)).size;
  const nomeMes = nomeDoMes(mes);
  if (!nGer) {
    box.innerHTML = `Nenhuma gerência com lançamento em <strong>${nomeMes}</strong> para este filtro. Importe os dados primeiro.`;
    return;
  }
  const media = lista.reduce((s, l) => s + (l.indice_prevencao || 0), 0) / lista.length;
  box.innerHTML = `<strong>${nGer}</strong> gerência(s) com lançamento em <strong>${nomeMes}</strong>. ` +
    `IP médio: <strong>${fmt(media)}</strong>. A apresentação terá ${nGer + 1} slide(s) ou mais.`;
}

function nomeDoMes(mesVal) {
  if (!mesVal) return '';
  const [ano, num] = mesVal.split('-');
  const m = MESES_SAFRA.find(x => x.num === num);
  return (m ? m.nome : num) + '/' + ano;
}

function fmt(v, casas = 1) {
  if (v == null || isNaN(v)) return '—';
  return Number(v).toLocaleString('pt-BR', { minimumFractionDigits: casas, maximumFractionDigits: casas });
}
function fmtNum(v) {
  if (v == null || v === '' || isNaN(v)) return '—';
  return Number(v).toLocaleString('pt-BR', { maximumFractionDigits: 2 });
}

