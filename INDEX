async function gravarImportacaoWecheckObs(prontos) {
  const { data: safrasBanco } = await sb.from('safras').select('id,nome,ano_ini,ano_fim');
  const acharSafraId = safraTxt => {
    const m = (safraTxt || '').match(/(\d{4})\s*\/\s*(\d{4})/);
    if (!m) return null;
    const ini = parseInt(m[1], 10), fim = parseInt(m[2], 10);
    const s = (safrasBanco || []).find(s => s.ano_ini === ini && s.ano_fim === fim);
    return s ? s.id : null;
  };

  // Família completa de indicadores de Observações (mensal, quinzenal, trimestral,
  // semana 1-4) — pra limpar pendências de um tipo que sumiu da planilha atual, mesmo
  // que essa gerência não tenha nenhuma linha desse tipo específico dessa vez. Mesmo
  // ajuste feito no Plano de Ação e nas Inspeções.
  const familiaObs = [NOME_IND_OBS_MENSAL, NOME_IND_OBS_QUINZENAL, NOME_IND_OBS_TRIMESTRAL, ...Object.values(NOME_IND_OBS_SEMANA)];
  const { data: indsFamObs } = await sb.from('indicadores').select('id').in('nome', familiaObs);
  const idsFamiliaObs = (indsFamObs || []).map(i => i.id);

  const porLancamento = {};
  const semSafra = [];
  prontos.forEach(g => {
    const safraId = acharSafraId(g.safraTxt);
    if (!safraId) { semSafra.push(g); return; }
    const chave = g.gerId + '|' + safraId + '|' + g.mes;
    if (!porLancamento[chave]) porLancamento[chave] = { gerId: g.gerId, safraId, mes: g.mes, itens: [] };
    porLancamento[chave].itens.push({ indicador_id: g.indicadorId, previsto: g.previsto, realizado: g.realizado, peso: g.peso, pessoas: g.pessoas || [] });
  });
  if (semSafra.length) console.warn(semSafra.length + ' grupo(s) sem safra reconhecida:', semSafra);

  let ok = 0; const erros = [];

  for (const chave in porLancamento) {
    const grupo = porLancamento[chave];
    try {
      const { data: ex } = await sb.from('lancamentos').select('id')
        .eq('gerencia_id', grupo.gerId).eq('safra_id', grupo.safraId).eq('mes', grupo.mes).limit(1);
      let lancId = ex?.[0]?.id || null;
      if (!lancId) {
        const { data: ins, error: eIns } = await sb.from('lancamentos').insert({
          gerencia_id: grupo.gerId, safra_id: grupo.safraId, mes: grupo.mes, periodo: grupo.mes,
          atualizado_em: new Date().toISOString()
        }).select('id');
        if (eIns) throw eIns;
        lancId = ins?.[0]?.id;
      }

      const idsIndicadores = grupo.itens.map(it => it.indicador_id);
      await sb.from('lancamento_itens').delete().eq('lancamento_id', lancId).in('indicador_id', idsIndicadores);
      const novasLinhas = grupo.itens.map(it => ({
        lancamento_id: lancId, indicador_id: it.indicador_id,
        previsto: it.previsto, realizado: it.realizado
      }));
      const { error: eItens } = await sb.from('lancamento_itens').insert(novasLinhas);
      if (eItens) throw eItens;

      await sb.from('lancamento_pendencias').delete().eq('lancamento_id', lancId).in('indicador_id', idsFamiliaObs);
      const linhasPessoas = [];
      grupo.itens.forEach(it => {
        (it.pessoas || []).forEach(p => {
          linhasPessoas.push({ lancamento_id: lancId, indicador_id: it.indicador_id, nome: p.nome, cargo: p.cargo, matricula: p.matricula, status: p.status });
        });
      });
      if (linhasPessoas.length) {
        const { error: ePess } = await sb.from('lancamento_pendencias').insert(linhasPessoas);
        if (ePess) console.warn('Não consegui gravar o detalhe por pessoa:', ePess.message);
      }

      const { data: todosItens } = await sb.from('lancamento_itens').select('*').eq('lancamento_id', lancId);
      const indsGer = await getIndsGerencia(grupo.gerId, grupo.safraId);
      const pg = calcPontGer(todosItens || [], indsGer || []);

      const { aud, mediaDir } = await recalcularAuditoriaEMediaDiretoria(grupo.gerId, grupo.mes, grupo.safraId, pg);
      const { data: lancAtual } = await sb.from('lancamentos').select('ajuste_pontos').eq('id', lancId).limit(1);
      const aj = lancAtual?.[0]?.ajuste_pontos || 0;
      const indBase = calcIndice(pg, mediaDir, aud, 0);
      const indFinal = calcIndice(pg, mediaDir, aud, aj);

      await sb.from('lancamentos').update({
        pontuacao_gerencia: pg, media_diretoria: mediaDir, nota_auditoria: aud,
        indice_base: indBase, indice_prevencao: indFinal,
        atualizado_em: new Date().toISOString()
      }).eq('id', lancId);

      ok++;
    } catch (err) {
      erros.push({ chave, erro: err.message });
    }
  }
  return { ok, erros };
}

// ===== Importação de planilha WeCheck Plano de Ação -> lançamentos reais no IP =====
// Reaproveita campo, montarMes, normaliza, SINONIMOS_UNIDADE, ALIASES_GERENCIA
// (já globais, definidos pelo importador de Inspeção).

// baseNomeGerencia não é global — repete a mesma lógica aqui (mesmo motivo do de Observação).
function baseNomeGerenciaPA(nome) {
  return (nome || '').toString().trim()
    .replace(/\s*-\s*(JB|PB)\s*$/i, '')
    .replace(/^ger[eê]ncia\s+/i, '');
}

const MESES_ABREV_PT = { jan:'01', fev:'02', mar:'03', abr:'04', mai:'05', jun:'06', jul:'07', ago:'08', set:'09', out:'10', nov:'11', dez:'12' };

// Aceita "2026/2027" OU "26/27" -> {ini, fim} sempre em 4 dígitos.
function normalizarAnoSafraPA(txt) {
  const m = (txt || '').toString().match(/(\d{2,4})\s*\/\s*(\d{2,4})/);
  if (!m) return null;
  const expandir = s => s.length === 2 ? (parseInt(s, 10) < 70 ? 2000 + parseInt(s, 10) : 1900 + parseInt(s, 10)) : parseInt(s, 10);
  return { ini: expandir(m[1]), fim: expandir(m[2]) };
}

// O relatório de Plano de Ação já mudou de formato de período umas 3x — esta função
// tenta, em ordem: (1) MES/ANO-SAFRA padrão das outras planilhas; (2) "Mes Ano"
// abreviado tipo "ago/26"; (3) "Mes Nome" completo ("agosto") + "Safra" ("26/27" ou
// "2026/2027"). O que funcionar primeiro, usa.
function montarMesESafraPA(l) {
  let mes = montarMes(l);
  let safraTxt = (campo(l, ['ANO/SAFRA', 'Ano Safra', 'ANO_SAFRA', 'SAFRA', 'Safra']) || '').toString().trim();

  if (!mes) {
    const combo = (campo(l, ['Mes Ano', 'MES ANO', 'MesAno']) || '').toString().trim().toLowerCase();
    const m = combo.match(/^([a-zç]{3})\/(\d{2})$/);
    if (m) {
      const mesNum = MESES_ABREV_PT[m[1]];
      if (mesNum) {
        const ano2 = parseInt(m[2], 10);
        const ano = ano2 < 70 ? 2000 + ano2 : 1900 + ano2;
        mes = ano + '-' + mesNum;
        if (!safraTxt) {
          const anoIni = parseInt(mesNum, 10) >= 4 ? ano : ano - 1;
          safraTxt = anoIni + '/' + (anoIni + 1);
        }
      }
    }
  }

  if (!mes) {
    const mesNome = (campo(l, ['Mes Nome', 'Mês', 'MES_NOME', 'Mes_Nome']) || '').toString().trim().toLowerCase();
    const mesNum = MESES_PT[mesNome];
    if (mesNum) {
      const safraObj = normalizarAnoSafraPA(safraTxt);
      if (safraObj) mes = (parseInt(mesNum, 10) >= 4 ? safraObj.ini : safraObj.fim) + '-' + mesNum;
    }
  }

  if (safraTxt && !/^\d{4}\/\d{4}$/.test(safraTxt)) {
    const safraObj = normalizarAnoSafraPA(safraTxt);
    if (safraObj) safraTxt = safraObj.ini + '/' + safraObj.fim;
  }

  if (!mes || !safraTxt) return null;
  return { mes, safraTxt };
}
const NOME_IND_PA_INSPECOES  = 'Nº de Ações de Inspeções de SSMA';
const NOME_IND_PA_SIMULADOS  = 'Nº de Ações de Simulados';
const NOME_IND_PA_ABRANGENCIA= 'Nº de Ações de Acidentes/Abrangência';
const NOME_IND_PA_ACID_INC   = 'Nº de Ações de Acidentes/Incidentes';
const NOME_IND_PA_ERGONOMIA  = 'Nº de Ações de Ergonomia';

// Classifica o texto livre de "Tipo de Plano de Ação" em um dos 5 indicadores.
function classificarPlanoAcao(tipoTxt) {
  const t = normaliza(tipoTxt);
  if (t.includes('INSPECAO')) return NOME_IND_PA_INSPECOES;
  if (t.includes('ABRANGENCIA')) return NOME_IND_PA_ABRANGENCIA;
  if (t.includes('INCIDENTE') || t.includes('ACIDENTE')) return NOME_IND_PA_ACID_INC;
  if (t.includes('ALARME')) return NOME_IND_PA_SIMULADOS;
  if (t.includes('ERGONOMIA')) return NOME_IND_PA_ERGONOMIA;
  return null;
}

async function importarPlanilhaWecheckPlanoAcao(evento) {
  const arquivos = Array.from(evento.target.files || []);
  if (!arquivos.length) return;

  try {
    const todasLinhas = [];
    for (const arquivo of arquivos) {
      const buffer = await arquivo.arrayBuffer();
      const wb = XLSX.read(new Uint8Array(buffer), { type: 'array' });
      wb.SheetNames.forEach(nomeAba => {
        const linhasAba = XLSX.utils.sheet_to_json(wb.Sheets[nomeAba], { defval: null });
        todasLinhas.push(...linhasAba);
      });
    }

    // Previsto = total de planos daquele tipo/gerência/mês; Realizado = quantos NÃO
    // estão Atrasados (Concluída + Pendente no prazo contam como "em dia").
    const grupos = {};
    const linhasIgnoradas = [];

    todasLinhas.forEach(l => {
      const gerNome = (campo(l, ['GERENCIA', 'Gerencia', 'Gerência']) || '').trim();
      const unidadeNome = (campo(l, ['UNIDADE2', 'UNIDADE', 'Unidade']) || '').trim();
      const r = montarMesESafraPA(l);
      const mes = r ? r.mes : null;
      const safraTxt = r ? r.safraTxt : '';
      const tipo = campo(l, ['Tipo de Plano de Ação', 'TIPO DE PLANO DE AÇÃO', 'Tipo']);
      const nomeIndicador = classificarPlanoAcao(tipo);
      if (!gerNome || !unidadeNome || !mes || !nomeIndicador) {
        linhasIgnoradas.push({ gerNome, unidadeNome, mes, tipo });
        return;
      }

      const status = normaliza(campo(l, ['Status', 'STATUS']));
      const emDia = /CONCLU/.test(status) ? 1 : 0; // só Concluída conta como Realizado — Atrasada e Andamento não contam

      const chave = gerNome + '|' + unidadeNome + '|' + mes + '|' + nomeIndicador;
      if (!grupos[chave]) grupos[chave] = { gerNome, unidadeNome, mes, safraTxt, nomeIndicador, previsto: 0, realizado: 0, pessoas: [] };
      grupos[chave].previsto += 1;
      grupos[chave].realizado += emDia;
      grupos[chave].pessoas.push({
        nome: (campo(l, ['Ação', 'AÇÃO']) || '').toString().trim(),        // aqui "pessoa" = a ação em si, pra dar pra ver detalhe
        cargo: (campo(l, ['Responsável', 'RESPONSÁVEL']) || '').toString().trim(),
        matricula: (campo(l, ['Número', 'NÚMERO']) || '').toString().trim(),
        status: (campo(l, ['Status', 'STATUS']) || '').toString().trim()
      });
    });

    if (linhasIgnoradas.length) console.warn(linhasIgnoradas.length + ' linha(s) ignorada(s):', linhasIgnoradas.slice(0, 20));

    const listaGrupos = Object.values(grupos);
    if (!listaGrupos.length) {
      alert('Não encontrei nenhuma linha válida. Confira GERENCIA/Gerencia, UNIDADE2/UNIDADE, MES, ANO/SAFRA e "Tipo de Plano de Ação".');
      return;
    }

    const [{ data: gers }, { data: unids }, { data: inds }] = await Promise.all([
      sb.from('gerencias').select('id,nome,unidade_id').eq('ativo', true),
      sb.from('unidades').select('id,nome'),
      sb.from('indicadores').select('id,nome,tipo,peso').eq('ativo', true)
    ]);

    const acharUnidadeId = nomeExport => {
      const norm = normaliza(nomeExport);
      const alvo = SINONIMOS_UNIDADE[norm] || nomeExport;
      const u = (unids || []).find(u => normaliza(u.nome) === normaliza(alvo));
      return u ? u.id : null;
    };
    const acharGerId = (gerNomeOriginal, unidadeNome) => {
      const apelido = ALIASES_GERENCIA[normaliza(gerNomeOriginal)];
      const gerNome = apelido || gerNomeOriginal;
      const base = normaliza(baseNomeGerenciaPA(gerNome));
      const unidadeId = acharUnidadeId(unidadeNome);
      if (unidadeId) {
        const c1 = (gers || []).filter(g => normaliza(baseNomeGerenciaPA(g.nome)) === base && g.unidade_id === unidadeId);
        if (c1.length === 1) return { id: c1[0].id };
        if (c1.length > 1) return { erro: 'gerência ambígua (' + c1.length + ' registros nome+unidade)' };
      }
      const c2 = (gers || []).filter(g => normaliza(baseNomeGerenciaPA(g.nome)) === base);
      if (c2.length === 1) return { id: c2[0].id };
      if (c2.length > 1) return { erro: 'gerência ambígua (' + c2.length + ' registros só de nome, unidade "' + unidadeNome + '" não bateu com nenhum)' };
      return { erro: 'gerência não encontrada' };
    };
    const acharIndicadorPorNome = nome => (inds || []).find(i => normaliza(i.nome) === normaliza(nome)) || null;

    const prontosBrutos = [];
    const semMatch = [];
    listaGrupos.forEach(gr => {
      const resGer = acharGerId(gr.gerNome, gr.unidadeNome);
      const ind = acharIndicadorPorNome(gr.nomeIndicador);
      if (resGer.erro || !ind) { semMatch.push({ ...gr, erroGer: resGer.erro, ind }); return; }
      prontosBrutos.push({ ...gr, gerId: resGer.id, indicadorId: ind.id, peso: ind.peso });
    });

    const mesclados = {};
    prontosBrutos.forEach(p => {
      const chave = p.gerId + '|' + p.safraTxt + '|' + p.mes + '|' + p.indicadorId;
      if (!mesclados[chave]) mesclados[chave] = { ...p };
      else {
        mesclados[chave].previsto += p.previsto;
        mesclados[chave].realizado += p.realizado;
        mesclados[chave].pessoas = (mesclados[chave].pessoas || []).concat(p.pessoas || []);
      }
    });
    const prontos = Object.values(mesclados);

    if (semMatch.length) {
      const detalhe = semMatch.slice(0, 10).map(s =>
        `- ${s.gerNome} (${s.unidadeNome}) / ${s.nomeIndicador} (${s.erroGer || ''}${s.erroGer && !s.ind ? ' e ' : ''}${!s.ind ? 'indicador não encontrado' : ''})`
      ).join('\n');
      const seguir = confirm(
        'Não encontrei correspondência para ' + semMatch.length + ' grupo(s):\n\n' + detalhe +
        (semMatch.length > 10 ? '\n... e mais ' + (semMatch.length - 10) : '') +
        '\n\nEsses grupos NÃO serão importados. Continuar só com os ' + prontos.length + ' que deram certo?'
      );
      if (!seguir) return;
    }
    if (!prontos.length) { alert('Nenhum grupo pôde ser importado.'); return; }

    const nomeResumo = arquivos.length === 1 ? arquivos[0].name : arquivos.length + ' arquivos selecionados';
    await mostrarPreviaImportacaoPAV2(prontos, nomeResumo);
  } catch (err) {
    console.error(err);
    alert('Erro ao ler a(s) planilha(s): ' + err.message);
  } finally {
    evento.target.value = '';
  }
}

async function mostrarPreviaImportacaoPAV2(prontos, nomeArquivo) {
  const linhasHtml = prontos.map(g => {
    const pct = g.previsto > 0 ? Math.min((g.realizado / g.previsto) * 100, 100) : (g.realizado === 0 ? 100 : 0);
    return `<tr>
      <td style="padding:6px 10px;border-bottom:1px solid #eee">${g.gerNome}</td>
      <td style="padding:6px 10px;border-bottom:1px solid #eee">${g.mes}</td>
      <td style="padding:6px 10px;border-bottom:1px solid #eee">${g.nomeIndicador}</td>
      <td style="padding:6px 10px;border-bottom:1px solid #eee;text-align:center">${g.previsto}</td>
      <td style="padding:6px 10px;border-bottom:1px solid #eee;text-align:center">${g.realizado}</td>
      <td style="padding:6px 10px;border-bottom:1px solid #eee;text-align:center;font-weight:600">${pct.toFixed(1)}%</td>
    </tr>`;
  }).join('');

  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;display:flex;align-items:center;justify-content:center;';
  overlay.innerHTML = `
    <div style="background:#fff;border-radius:10px;max-width:800px;width:90%;max-height:80vh;overflow:auto;padding:24px;">
      <h3 style="margin:0 0 4px">Prévia da importação (Plano de Ação) — ${nomeArquivo}</h3>
      <p style="color:#666;font-size:13px;margin:0 0 16px">${prontos.length} lançamento(s) de indicador serão gravados/atualizados. Previsto = total de planos; Realizado = não Atrasados. Nada foi salvo ainda.</p>
      <table style="width:100%;border-collapse:collapse;font-size:13px">
        <thead><tr style="background:#f5f5f5">
          <th style="padding:6px 10px;text-align:left">Gerência</th>
          <th style="padding:6px 10px;text-align:left">Mês</th>
          <th style="padding:6px 10px;text-align:left">Indicador</th>
          <th style="padding:6px 10px">Previsto</th>
          <th style="padding:6px 10px">Realizado</th>
          <th style="padding:6px 10px">%</th>
        </tr></thead>
        <tbody>${linhasHtml}</tbody>
      </table>
      <div style="text-align:right;margin-top:16px">
        <button id="btn-cancelar-previa-pa" style="padding:8px 16px;border-radius:6px;border:1px solid #ccc;background:#fff;cursor:pointer;margin-right:8px">Cancelar</button>
        <button id="btn-confirmar-previa-pa" style="padding:8px 16px;border-radius:6px;border:none;background:#07583C;color:#fff;cursor:pointer">Confirmar e Gravar</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  document.getElementById('btn-cancelar-previa-pa').onclick = () => overlay.remove();
  document.getElementById('btn-confirmar-previa-pa').onclick = async () => {
    const btn = document.getElementById('btn-confirmar-previa-pa');
    btn.disabled = true; btn.textContent = 'Gravando...';
    try {
      const resumo = await gravarImportacaoWecheckPA(prontos);
      overlay.remove();
      alert('Importação concluída.\n' + resumo.ok + ' lançamento(s) atualizado(s) com sucesso.' +
        (resumo.erros.length ? '\n' + resumo.erros.length + ' com erro (veja o console).' : ''));
      if (resumo.erros.length) console.error('Erros na importação:', resumo.erros);
      if (typeof onPeriodoLancarChange === 'function') onPeriodoLancarChange();
    } catch (err) {
      alert('Erro ao gravar: ' + err.message);
      btn.disabled = false; btn.textContent = 'Confirmar e Gravar';
    }
  };
}

async function gravarImportacaoWecheckPA(prontos) {
  const { data: safrasBanco } = await sb.from('safras').select('id,nome,ano_ini,ano_fim');
  const acharSafraId = safraTxt => {
    const m = (safraTxt || '').match(/(\d{4})\s*\/\s*(\d{4})/);
    if (!m) return null;
    const ini = parseInt(m[1], 10), fim = parseInt(m[2], 10);
    const s = (safrasBanco || []).find(s => s.ano_ini === ini && s.ano_fim === fim);
    return s ? s.id : null;
  };

  // Os 5 tipos de Plano de Ação sempre vêm do MESMO relatório/export — se uma gerência
  // não tem mais nenhuma linha de um tipo (ex: "Inspeções de SSMA") nessa importação, é
  // porque não tem mais pendência aberta desse tipo (foi resolvida e saiu do relatório).
  // Por isso a limpeza de pendências usa esses 5 IDs sempre, não só os que aparecem na
  // planilha atual — senão pendência de um tipo que "sumiu" do relatório nunca era apagada.
  const { data: indsPA } = await sb.from('indicadores').select('id,nome')
    .in('nome', [NOME_IND_PA_INSPECOES, NOME_IND_PA_SIMULADOS, NOME_IND_PA_ABRANGENCIA, NOME_IND_PA_ACID_INC, NOME_IND_PA_ERGONOMIA]);
  const idsTodosIndicadoresPA = (indsPA || []).map(i => i.id);

  const porLancamento = {};
  const semSafra = [];
  prontos.forEach(g => {
    const safraId = acharSafraId(g.safraTxt);
    if (!safraId) { semSafra.push(g); return; }
    const chave = g.gerId + '|' + safraId + '|' + g.mes;
    if (!porLancamento[chave]) porLancamento[chave] = { gerId: g.gerId, safraId, mes: g.mes, itens: [] };
    porLancamento[chave].itens.push({ indicador_id: g.indicadorId, previsto: g.previsto, realizado: g.realizado, peso: g.peso, pessoas: g.pessoas || [] });
  });
  if (semSafra.length) console.warn(semSafra.length + ' grupo(s) sem safra reconhecida:', semSafra);

  let ok = 0; const erros = [];

  for (const chave in porLancamento) {
    const grupo = porLancamento[chave];
    try {
      const { data: ex } = await sb.from('lancamentos').select('id')
        .eq('gerencia_id', grupo.gerId).eq('safra_id', grupo.safraId).eq('mes', grupo.mes).limit(1);
      let lancId = ex?.[0]?.id || null;
      if (!lancId) {
        const { data: ins, error: eIns } = await sb.from('lancamentos').insert({
          gerencia_id: grupo.gerId, safra_id: grupo.safraId, mes: grupo.mes, periodo: grupo.mes,
          atualizado_em: new Date().toISOString()
        }).select('id');
        if (eIns) throw eIns;
        lancId = ins?.[0]?.id;
      }

      const idsIndicadores = grupo.itens.map(it => it.indicador_id);
      await sb.from('lancamento_itens').delete().eq('lancamento_id', lancId).in('indicador_id', idsIndicadores);
      const novasLinhas = grupo.itens.map(it => ({
        lancamento_id: lancId, indicador_id: it.indicador_id,
        previsto: it.previsto, realizado: it.realizado
      }));
      const { error: eItens } = await sb.from('lancamento_itens').insert(novasLinhas);
      if (eItens) throw eItens;

      // Detalhe por ação (reaproveita a mesma tabela de pendências — aqui "pendente"
      // vira "atrasada"; nome/cargo viram ação/responsável, matrícula vira número da ação).
      // Limpa os 5 tipos de PA sempre (idsTodosIndicadoresPA), não só os que essa
      // gerência tem nessa planilha — ver comentário lá em cima.
      await sb.from('lancamento_pendencias').delete().eq('lancamento_id', lancId).in('indicador_id', idsTodosIndicadoresPA);
      const linhasPessoas = [];
      grupo.itens.forEach(it => {
        (it.pessoas || []).forEach(p => {
          linhasPessoas.push({ lancamento_id: lancId, indicador_id: it.indicador_id, nome: p.nome, cargo: p.cargo, matricula: p.matricula, status: p.status });
        });
      });
      if (linhasPessoas.length) {
        const { error: ePess } = await sb.from('lancamento_pendencias').insert(linhasPessoas);
        if (ePess) console.warn('Não consegui gravar o detalhe por ação:', ePess.message);
      }

      const { data: todosItens } = await sb.from('lancamento_itens').select('*').eq('lancamento_id', lancId);
      const indsGer = await getIndsGerencia(grupo.gerId, grupo.safraId);
      const pg = calcPontGer(todosItens || [], indsGer || []);

      const { aud, mediaDir } = await recalcularAuditoriaEMediaDiretoria(grupo.gerId, grupo.mes, grupo.safraId, pg);
      const { data: lancAtual } = await sb.from('lancamentos').select('ajuste_pontos').eq('id', lancId).limit(1);
      const aj = lancAtual?.[0]?.ajuste_pontos || 0;
      const indBase = calcIndice(pg, mediaDir, aud, 0);
      const indFinal = calcIndice(pg, mediaDir, aud, aj);

      await sb.from('lancamentos').update({
        pontuacao_gerencia: pg, media_diretoria: mediaDir, nota_auditoria: aud,
        indice_base: indBase, indice_prevencao: indFinal,
        atualizado_em: new Date().toISOString()
      }).eq('id', lancId);

      ok++;
    } catch (err) {
      erros.push({ chave, erro: err.message });
    }
  }
  return { ok, erros };
}

// ===== Importação de Cronograma de Simulados -> lançamentos reais no IP =====
// Particularidade: a planilha só tem Diretoria (não Gerência) — cada linha
// se aplica a TODAS as gerências ativas daquela diretoria+unidade, com o
// previsto/realizado cheio (não dividido) em cada uma.

const NOME_IND_SIMULADOS_CRONOGRAMA = 'Nº de Simulados';

// Apelidos de nome de diretoria — a planilha às vezes usa o nome por extenso,
// o sistema usa abreviado.
const ALIASES_DIRETORIA = {
  'DIRETORIA FINANCEIRA': 'Diretoria Fin.'
};

// Remove espaços sobrando nas CHAVES do objeto (a planilha tem 'Unidade ', 'Diretoria ' com espaço no fim).
function linhaComChavesTrimadas(l) {
  const nova = {};
  Object.keys(l).forEach(k => { nova[k.trim()] = l[k]; });
  return nova;
}

// Mostra os meses presentes no arquivo (marcados por padrão) e deixa o usuário
// escolher quais entram na importação — útil pra planilha de cronograma anual,
// que sempre traz vários meses de uma vez. Retorna a lista de meses escolhidos
// (formato "YYYY-MM"), ou null se cancelou.
function escolherMesesSimulados(linhasValidas) {
  return new Promise(resolve => {
    const nomesMes = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
    const mesesUnicos = [...new Set(linhasValidas.map(l => l.mes))].sort();
    if (mesesUnicos.length <= 1) { resolve(mesesUnicos); return; } // só 1 mês no arquivo, nem precisa perguntar

    const rotulo = mes => {
      const [ano, mm] = mes.split('-');
      return nomesMes[parseInt(mm, 10) - 1] + '/' + ano;
    };

    const overlay = document.createElement('div');
    overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;display:flex;align-items:center;justify-content:center;';
    overlay.innerHTML = `
      <div style="background:#fff;border-radius:10px;max-width:420px;width:90%;padding:24px;">
        <h3 style="margin:0 0 4px">Quais meses importar?</h3>
        <p style="color:#666;font-size:13px;margin:0 0 16px">O arquivo tem ${mesesUnicos.length} meses diferentes. Marca só os que você quer atualizar agora.</p>
        <div id="lista-meses-sim" style="max-height:260px;overflow:auto;border:1px solid #eee;border-radius:6px;padding:8px 12px;">
          ${mesesUnicos.map((m, i) => `
            <label style="display:flex;align-items:center;gap:8px;padding:6px 0;cursor:pointer;font-size:14px">
              <input type="checkbox" class="chk-mes-sim" value="${m}" checked>
              ${rotulo(m)}
            </label>`).join('')}
        </div>
        <div style="display:flex;justify-content:space-between;margin-top:12px">
          <span>
            <button id="btn-marcar-todos-sim" style="font-size:12px;border:none;background:none;color:#07583C;cursor:pointer;text-decoration:underline">marcar todos</button>
            <button id="btn-desmarcar-todos-sim" style="font-size:12px;border:none;background:none;color:#888;cursor:pointer;text-decoration:underline;margin-left:8px">desmarcar todos</button>
          </span>
        </div>
        <div style="text-align:right;margin-top:16px">
          <button id="btn-cancelar-mes-sim" style="padding:8px 16px;border-radius:6px;border:1px solid #ccc;background:#fff;cursor:pointer;margin-right:8px">Cancelar</button>
          <button id="btn-continuar-mes-sim" style="padding:8px 16px;border-radius:6px;border:none;background:#07583C;color:#fff;cursor:pointer">Continuar</button>
        </div>
      </div>`;
    document.body.appendChild(overlay);

    document.getElementById('btn-marcar-todos-sim').onclick = () => overlay.querySelectorAll('.chk-mes-sim').forEach(c => c.checked = true);
    document.getElementById('btn-desmarcar-todos-sim').onclick = () => overlay.querySelectorAll('.chk-mes-sim').forEach(c => c.checked = false);
    document.getElementById('btn-cancelar-mes-sim').onclick = () => { overlay.remove(); resolve(null); };
    document.getElementById('btn-continuar-mes-sim').onclick = () => {
      const escolhidos = [...overlay.querySelectorAll('.chk-mes-sim:checked')].map(c => c.value);
      overlay.remove();
      if (!escolhidos.length) { alert('Marca pelo menos um mês.'); resolve(null); return; }
      resolve(escolhidos);
    };
  });
}

async function importarPlanilhaWecheckSimulados(evento) {
  const arquivos = Array.from(evento.target.files || []);
  if (!arquivos.length) return;

  try {
    const todasLinhas = [];
    for (const arquivo of arquivos) {
      const buffer = await arquivo.arrayBuffer();
      const wb = XLSX.read(new Uint8Array(buffer), { type: 'array' });
      wb.SheetNames.forEach(nomeAba => {
        const linhasAba = XLSX.utils.sheet_to_json(wb.Sheets[nomeAba], { defval: null });
        linhasAba.forEach(l => todasLinhas.push(linhaComChavesTrimadas(l)));
      });
    }

    const linhasValidas = [];
    const linhasIgnoradas = [];
    todasLinhas.forEach(l => {
      const unidadeNome = (campo(l, ['Unidade', 'UNIDADE']) || '').trim();
      const diretoriaNome = (campo(l, ['Diretoria', 'DIRETORIA']) || '').trim();
      const mes = montarMes(l) || (() => {
        // MÊS (nome completo) + ANO/SAFRA, mesmo esquema do resto do sistema
        const mesNome = (campo(l, ['MÊS', 'Mês', 'MES']) || '').toString().trim().toLowerCase();
        const mesNum = MESES_PT[mesNome];
        const safraTxt = (campo(l, ['ANO/SAFRA', 'Ano Safra', 'SAFRA']) || '').toString().trim();
        if (!mesNum) return null;
        const ano = anoDaSafraParaMes(safraTxt, parseInt(mesNum, 10));
        return ano ? ano + '-' + mesNum : null;
      })();
      const safraTxt = (campo(l, ['ANO/SAFRA', 'Ano Safra', 'SAFRA']) || '').toString().trim();
      const planejado = parseFloat(campo(l, ['PLANEJADO', 'Planejado'])) || 0;
      const realizado = parseFloat(campo(l, ['REALIZADO', 'Realizado'])) || 0;

      if (!unidadeNome || !diretoriaNome || !mes || !safraTxt) {
        linhasIgnoradas.push({ unidadeNome, diretoriaNome, mes, safraTxt });
        return;
      }
      linhasValidas.push({ unidadeNome, diretoriaNome, mes, safraTxt, planejado, realizado, oQue: (campo(l, ['O que']) || '').toString().trim() });
    });

    if (linhasIgnoradas.length) console.warn(linhasIgnoradas.length + ' linha(s) ignorada(s):', linhasIgnoradas.slice(0, 20));
    if (!linhasValidas.length) {
      alert('Não encontrei nenhuma linha válida. Confira Unidade, Diretoria, MÊS, ANO/SAFRA, PLANEJADO, REALIZADO.');
      return;
    }

    const mesesEscolhidos = await escolherMesesSimulados(linhasValidas);
    if (!mesesEscolhidos) return; // cancelou
    const linhasFiltradas = linhasValidas.filter(l => mesesEscolhidos.includes(l.mes));
    if (!linhasFiltradas.length) { alert('Nenhuma linha nos meses selecionados.'); return; }

    const [{ data: gers }, { data: unids }, { data: diretorias }, { data: inds }] = await Promise.all([
      sb.from('gerencias').select('id,nome,diretoria_id,unidade_id').eq('ativo', true),
      sb.from('unidades').select('id,nome'),
      sb.from('diretorias').select('id,nome'),
      sb.from('indicadores').select('id,nome,tipo,peso').eq('ativo', true)
    ]);

    const acharUnidadeId = nomeExport => {
      const norm = normaliza(nomeExport);
      const alvo = SINONIMOS_UNIDADE[norm] || nomeExport;
      const u = (unids || []).find(u => normaliza(u.nome) === normaliza(alvo));
      return u ? u.id : null;
    };
    const acharDiretoriaId = nomeOriginal => {
      const nome = ALIASES_DIRETORIA[normaliza(nomeOriginal)] || nomeOriginal;
      const d = (diretorias || []).find(d => normaliza(d.nome) === normaliza(nome));
      return d ? d.id : null;
    };
    const indicador = (inds || []).find(i => normaliza(i.nome) === normaliza(NOME_IND_SIMULADOS_CRONOGRAMA));

    if (!indicador) {
      alert('Não encontrei o indicador "' + NOME_IND_SIMULADOS_CRONOGRAMA + '" cadastrado (ativo) no sistema. Cria ele antes de importar.');
      return;
    }

    // Pra cada linha, acha a diretoria+unidade e expande pra TODAS as gerências
    // ativas daquela combinação, com o previsto/realizado cheio em cada uma.
    const grupos = {}; // chave: gerId|safraTxt|mes -> {previsto, realizado}
    const semGerencia = [];
    linhasFiltradas.forEach(l => {
      const unidadeId = acharUnidadeId(l.unidadeNome);
      if (!unidadeId) { semGerencia.push({ ...l, motivo: 'unidade não encontrada' }); return; }

      let gerenciasAlvo;
      if (normaliza(l.diretoriaNome) === normaliza('Todas as diretorias')) {
        // Caso especial: aplica em todas as gerências ativas da unidade, sem filtrar por diretoria.
        gerenciasAlvo = (gers || []).filter(g => g.unidade_id === unidadeId);
      } else {
        const diretoriaId = acharDiretoriaId(l.diretoriaNome);
        if (!diretoriaId) { semGerencia.push({ ...l, motivo: 'diretoria não encontrada' }); return; }
        gerenciasAlvo = (gers || []).filter(g => g.diretoria_id === diretoriaId && g.unidade_id === unidadeId);
      }
      if (!gerenciasAlvo.length) { semGerencia.push({ ...l, motivo: 'nenhuma gerência ativa nessa diretoria+unidade' }); return; }

      gerenciasAlvo.forEach(g => {
        const chave = g.id + '|' + l.safraTxt + '|' + l.mes;
        if (!grupos[chave]) grupos[chave] = { gerId: g.id, gerNome: g.nome, safraTxt: l.safraTxt, mes: l.mes, previsto: 0, realizado: 0 };
        grupos[chave].previsto += l.planejado;
        grupos[chave].realizado += l.realizado;
      });
    });

    if (semGerencia.length) {
      const detalhe = semGerencia.slice(0, 10).map(s => `- ${s.diretoriaNome} (${s.unidadeNome}) — ${s.motivo}`).join('\n');
      const seguir = confirm(
        'Não encontrei gerência(s) pra ' + semGerencia.length + ' linha(s):\n\n' + detalhe +
        (semGerencia.length > 10 ? '\n... e mais ' + (semGerencia.length - 10) : '') +
        '\n\nEssas linhas NÃO serão importadas. Continuar com o resto?'
      );
      if (!seguir) return;
    }

    const prontos = Object.values(grupos).map(g => ({ ...g, indicadorId: indicador.id, nomeIndicador: NOME_IND_SIMULADOS_CRONOGRAMA }));
    if (!prontos.length) { alert('Nenhum lançamento pôde ser importado.'); return; }

    const nomeResumo = arquivos.length === 1 ? arquivos[0].name : arquivos.length + ' arquivos selecionados';
    await mostrarPreviaImportacaoSimuladosV2(prontos, nomeResumo);
  } catch (err) {
    console.error(err);
    alert('Erro ao ler a(s) planilha(s): ' + err.message);
  } finally {
    evento.target.value = '';
  }
}

