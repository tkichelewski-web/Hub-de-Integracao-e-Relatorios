<script>
// ═════════════════════════════════════════════════════════════════
// LÓGICA DE IMPORTAÇÃO — bloco original do sistema principal, intacto.
// ═════════════════════════════════════════════════════════════════
// ===== Importação de planilha WeCheck Inspeções -> lançamentos reais no IP =====

const MESES_PT = {
  'janeiro':'01','fevereiro':'02','março':'03','marco':'03','abril':'04','maio':'05','junho':'06',
  'julho':'07','agosto':'08','setembro':'09','outubro':'10','novembro':'11','dezembro':'12'
};

// Lê um campo aceitando variações de nome de coluna (acento/maiúsculas podem mudar no export)
function campo(l, chaves) {
  for (const k of chaves) if (l[k] != null && l[k] !== '') return l[k];
  return null;
}

function anoDaSafraParaMes(safraTxt, mesNum) {
  // "2026/2027" -> ano_ini=2026, ano_fim=2027. Meses >= abril usam ano_ini, os demais ano_fim
  // (mesma regra que o Power BI/sistema já usam pra safra).
  const m = (safraTxt || '').toString().match(/(\d{4})\s*\/\s*(\d{4})/);
  if (!m) return null;
  const anoIni = parseInt(m[1], 10), anoFim = parseInt(m[2], 10);
  return mesNum >= 4 ? anoIni : anoFim;
}

function montarMes(l) {
  const direto = campo(l, ['MES', 'Mes', 'Mês/Ano', 'AnoMes']);
  if (direto && /^\d{4}-\d{2}$/.test(direto.trim())) return direto.trim();

  const mesTexto = (campo(l, ['Mês', 'MES', 'MES_NOME', 'Mes_Nome']) || '').toString().trim().toLowerCase();
  const num = MESES_PT[mesTexto];
  if (!num) return null;

  const anoDireto = (campo(l, ['Ano', 'ANO']) || '').toString().trim();
  if (/^\d{4}$/.test(anoDireto)) return anoDireto + '-' + num;

  const safraTxt = campo(l, ['ANO/SAFRA', 'Ano Safra', 'ANO_SAFRA', 'SAFRA']);
  const ano = anoDaSafraParaMes(safraTxt, parseInt(num, 10));
  if (ano) return ano + '-' + num;

  return null;
}
// A planilha exporta a Unidade por extenso; o sistema usa sigla. Traduz antes de comparar.
const SINONIMOS_UNIDADE = {
  'JABOTICABAL': 'JB',
  'PEREIRA BARRETO': 'PB'
};

// Áreas que não têm gerência própria na planilha (reportam direto à diretoria/superintendência)
// -> gerência real que representa essa área no sistema.
const ALIASES_GERENCIA = {
  'DIRETORIA DE PESSOAS': 'RH/Jurídico/Restaurante/Saúde/Facilities',
  'SUPERINTENDENCIA': 'Supervisão Excelência e Projetos',
  'SUPERINTENDÊNCIA': 'Supervisão Excelência e Projetos',
  // As três reportam pra área única cadastrada como "RH/Jurídico/Restaurante/Saúde/Facilities".
  'SUPERVISAO FACILITIES': 'RH/Jurídico/Restaurante/Saúde/Facilities',
  'GERÊNCIA RH': 'RH/Jurídico/Restaurante/Saúde/Facilities',
  'GERENCIA RH': 'RH/Jurídico/Restaurante/Saúde/Facilities',
  'SUPERVISAO RH': 'RH/Jurídico/Restaurante/Saúde/Facilities',
  'GERÊNCIA JURIDICO': 'RH/Jurídico/Restaurante/Saúde/Facilities',
  'GERENCIA JURIDICO': 'RH/Jurídico/Restaurante/Saúde/Facilities',
  'SUPERVISAO JURIDICO': 'RH/Jurídico/Restaurante/Saúde/Facilities'
};

const NOME_IND_QUINZENA_1 = 'Nº de Inspeções SSMA -1º quinzena';
const NOME_IND_QUINZENA_2 = 'Nº de Inspeções SSMA -2º quinzena';
const NOME_IND_TRIMESTRAL = 'Nº de Inspeções SSMA - Trimestral';
const NOME_IND_MENSAL     = 'Nº de Inspeções SSMA - Mensal';
// Semanal tem 1 indicador por semana do mês (não um "Semanal" único).
const NOME_IND_SEMANA = {
  1: 'Nº de Inspeções SSMA - Semana 1',
  2: 'Nº de Inspeções SSMA - Semana 2',
  3: 'Nº de Inspeções SSMA - Semana 3',
  4: 'Nº de Inspeções SSMA - Semana 4'
};

// Aba (frequência de origem) -> indicador de destino.
// QUINZENAL precisa da coluna Quinzena, SEMANAL precisa da coluna Semana;
// MENSAL e TRIMESTRAL já têm indicador único, sem precisar rotear.
const ABA_INDICADOR_DIRETO = {
  'MENSAL':    NOME_IND_MENSAL,
  'TRIMESTRAL':NOME_IND_TRIMESTRAL
};

function acharIndicadorDaLinha(freq, quinzenaLinha, semanaLinha) {
  const f = normaliza(freq);
  if (ABA_INDICADOR_DIRETO[f]) return ABA_INDICADOR_DIRETO[f];
  if (f === 'QUINZENAL') {
    const q = (quinzenaLinha || '').trim();
    if (q.startsWith('1')) return NOME_IND_QUINZENA_1;
    if (q.startsWith('2')) return NOME_IND_QUINZENA_2;
  }
  if (f === 'SEMANAL') {
    const m = (semanaLinha || '').toString().match(/(\d+)/);
    const num = m ? parseInt(m[1], 10) : null;
    if (num && NOME_IND_SEMANA[num]) return NOME_IND_SEMANA[num];
  }
  return null; // frequência não reconhecida, ou faltou a coluna de período correspondente
}

function normaliza(s) {
  return (s || '').toString().trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
}

async function importarPlanilhaWecheckInspecoes(evento) {
  const arquivos = Array.from(evento.target.files || []);
  if (!arquivos.length) return;

  try {
    // Lê todos os arquivos selecionados (pode ser 1 arquivo com 4 abas, ou até 4 arquivos
    // separados — um por tabela exportada do Power BI). Junta todas as linhas de todas
    // as abas de todos os arquivos antes de processar.
    const todasLinhas = [];
    for (const arquivo of arquivos) {
      const buffer = await arquivo.arrayBuffer();
      const wb = XLSX.read(new Uint8Array(buffer), { type: 'array' });
      wb.SheetNames.forEach(nomeAba => {
        const linhasAba = XLSX.utils.sheet_to_json(wb.Sheets[nomeAba], { defval: null });
        todasLinhas.push(...linhasAba);
      });
    }

    // Cada LINHA já diz sua própria frequência (coluna Frequência Inspeção) e,
    // se for Quinzenal, também a Quinzena (1ª/2ª). As outras frequências (Mensal,
    // Semanal, Trimestral) já têm indicador próprio, sem precisar de Quinzena.
    const grupos = {};
    const linhasIgnoradas = [];

    todasLinhas.forEach(l => {
      const gerNome = (campo(l, ['GERENCIA']) || '').trim();
      const unidadeNome = (campo(l, ['UNIDADE']) || '').trim();
      const mes = montarMes(l);
      const safraTxt = (campo(l, ['ANO/SAFRA', 'Ano Safra', 'ANO_SAFRA', 'SAFRA']) || '').toString().trim();
      const freq = campo(l, ['FREQUENCIA', 'Frequência Inspeção', 'Frequencia Inspecao']);
      if (!gerNome || !unidadeNome || !mes || !freq) { linhasIgnoradas.push({ gerNome, unidadeNome, mes, freq }); return; }

      const quinzenaLinha = campo(l, ['QUINZENA', 'Quinzena']);
      const semanaLinha = campo(l, ['SEMANA', 'Semana']);
      const nomeIndicador = acharIndicadorDaLinha(freq, quinzenaLinha, semanaLinha);
      if (!nomeIndicador) { linhasIgnoradas.push({ gerNome, unidadeNome, mes, freq, semanaLinha }); return; }

      const meta = parseFloat(campo(l, ['META', 'Meta Dinamica Safra total geral', 'Meta'])) || 0;
      const real = parseFloat(campo(l, ['REALIZADO', 'Realizado_AteHoje', 'Realizado'])) || 0;
      const chave = gerNome + '|' + unidadeNome + '|' + mes + '|' + nomeIndicador;
      if (!grupos[chave]) grupos[chave] = { gerNome, unidadeNome, mes, safraTxt, nomeIndicador, previsto: 0, realizado: 0, pessoas: [] };
      grupos[chave].previsto += meta;
      grupos[chave].realizado += real;
      grupos[chave].pessoas.push({
        nome: (campo(l, ['NOME']) || '').toString().trim(),
        cargo: (campo(l, ['CARGO']) || '').toString().trim(),
        matricula: (campo(l, ['MATRICULA', 'Matrícula']) || '').toString().trim(),
        status: (campo(l, ['STATUS']) || '').toString().replace(/^●\s*/, '').trim()
      });
    });

    if (linhasIgnoradas.length) console.warn(linhasIgnoradas.length + ' linha(s) ignorada(s) (sem GERENCIA/UNIDADE/Mês/Frequência reconhecível, ou Quinzenal sem Quinzena):', linhasIgnoradas.slice(0, 20));

    const listaGrupos = Object.values(grupos);
    if (!listaGrupos.length) {
      alert('Não encontrei nenhuma linha válida. Confira se cada tabela tem as colunas GERENCIA, UNIDADE, Mês/Ano (ou MES), "Frequência Inspeção", META, REALIZADO — e, para Quinzenal, coluna Quinzena, ou para Semanal, coluna Semana (Semana 1 a 4).');
      return;
    }

    // 2. Busca gerências (só ativas), unidades e indicadores cadastrados
    const [{ data: gers }, { data: unids }, { data: inds }] = await Promise.all([
      sb.from('gerencias').select('id,nome,unidade_id').eq('ativo', true),
      sb.from('unidades').select('id,nome'),
      sb.from('indicadores').select('id,nome,tipo,peso').eq('ativo', true)
    ]);

    // Tira sufixo "- JB" / "- PB" do nome, se tiver, pra comparar só o nome-base.
    // Algumas gerências têm esse sufixo no nome (Industrial, Agrícola CTT e PPT),
    // outras diferenciam JB de PB só pelo unidade_id (mesmo nome, 2 registros).
    const baseNomeGerencia = nome => (nome || '').toString().trim()
      .replace(/\s*-\s*(JB|PB)\s*$/i, '')
      .replace(/^ger[eê]ncia\s+/i, '');

    const acharUnidadeId = nomeExport => {
      const norm = normaliza(nomeExport);
      const alvo = SINONIMOS_UNIDADE[norm] || nomeExport;
      const u = (unids || []).find(u => normaliza(u.nome) === normaliza(alvo));
      return u ? u.id : null;
    };
    const acharGerId = (gerNomeOriginal, unidadeNome) => {
      const apelido = ALIASES_GERENCIA[normaliza(gerNomeOriginal)];
      const gerNome = apelido || gerNomeOriginal;
      const base = normaliza(baseNomeGerencia(gerNome));
      const unidadeId = acharUnidadeId(unidadeNome);

      if (unidadeId) {
        const porNomeEUnidade = (gers || []).filter(g =>
          normaliza(baseNomeGerencia(g.nome)) === base && g.unidade_id === unidadeId
        );
        if (porNomeEUnidade.length === 1) return { id: porNomeEUnidade[0].id };
        if (porNomeEUnidade.length > 1) return { erro: 'gerência ambígua (' + porNomeEUnidade.length + ' registros nome+unidade)' };
      }

      // Sem match por nome+unidade: tenta só pelo nome (cobre gerências corporativas,
      // com 1 registro só, que atendem colaboradores de mais de uma unidade).
      const porNome = (gers || []).filter(g => normaliza(baseNomeGerencia(g.nome)) === base);
      if (porNome.length === 1) return { id: porNome[0].id };
      if (porNome.length > 1) return { erro: 'gerência ambígua (' + porNome.length + ' registros só de nome, unidade "' + unidadeNome + '" não bateu com nenhum)' };
      return { erro: 'gerência não encontrada' };
    };
    const acharIndicadorPorNome = nome =>
      (inds || []).find(i => normaliza(i.nome) === normaliza(nome)) || null;

    // 3. Resolve tudo; separa o que não deu match pra avisar antes de gravar
    const prontosBrutos = [];
    const semMatch = [];
    listaGrupos.forEach(gr => {
      const resGer = acharGerId(gr.gerNome, gr.unidadeNome);
      const ind = acharIndicadorPorNome(gr.nomeIndicador);
      if (resGer.erro || !ind) { semMatch.push({ ...gr, erroGer: resGer.erro, ind }); return; }
      prontosBrutos.push({ ...gr, gerId: resGer.id, indicadorId: ind.id, peso: ind.peso });
    });

    // Gerências corporativas (JB/PB) aparecem na planilha em 2 leituras separadas
    // (colaboradores de "Jaboticabal" e de "Pereira Barreto"), mas resolvem pro MESMO
    // gerId — sem isso, o mesmo indicador entraria 2x pro mesmo lançamento em vez de somado.
    const mesclados = {};
    prontosBrutos.forEach(p => {
      const chave = p.gerId + '|' + p.safraTxt + '|' + p.mes + '|' + p.indicadorId;
      if (!mesclados[chave]) mesclados[chave] = { ...p };
      else {
        mesclados[chave].previsto += p.previsto;
        mesclados[chave].realizado += p.realizado;
        mesclados[chave].pessoas = (mesclados[chave].pessoas || []).concat(p.pessoas || []);
      }
    });
    const prontos = Object.values(mesclados);

    if (semMatch.length) {
      const detalhe = semMatch.slice(0, 10).map(s =>
        `- ${s.gerNome} (${s.unidadeNome}) / ${s.nomeIndicador} (${s.erroGer || ''}${s.erroGer && !s.ind ? ' e ' : ''}${!s.ind ? 'indicador não encontrado' : ''})`
      ).join('\n');
      const seguir = confirm(
        'Não encontrei correspondência para ' + semMatch.length + ' grupo(s):\n\n' + detalhe +
        (semMatch.length > 10 ? '\n... e mais ' + (semMatch.length - 10) : '') +
        '\n\nEsses grupos NÃO serão importados. Continuar só com os ' + prontos.length + ' que deram certo?'
      );
      if (!seguir) return;
    }
    if (!prontos.length) { alert('Nenhum grupo pôde ser importado.'); return; }

    const nomeResumo = arquivos.length === 1 ? arquivos[0].name : arquivos.length + ' arquivos selecionados';
    const familiaInspecoes = [NOME_IND_QUINZENA_1, NOME_IND_QUINZENA_2, NOME_IND_TRIMESTRAL, NOME_IND_MENSAL, ...Object.values(NOME_IND_SEMANA)];
    await mostrarPreviaImportacaoV2(prontos, nomeResumo, familiaInspecoes);
  } catch (err) {
    console.error(err);
    alert('Erro ao ler a(s) planilha(s): ' + err.message +
      '\nConfira se cada tabela tem as colunas GERENCIA, Mês/Ano (ou MES), "Frequência Inspeção", "Meta Dinamica Safra total geral" e "Realizado_AteHoje".');
  } finally {
    evento.target.value = '';
  }
}

// Mostra a prévia; só grava quando o usuário confirma
async function mostrarPreviaImportacaoV2(prontos, nomeArquivo, familiaIndicadores) {
  const linhasHtml = prontos.map(g => {
    const pct = g.previsto > 0 ? Math.min((g.realizado / g.previsto) * 100, 100) : (g.realizado === 0 ? 100 : 0);
    return `<tr>
      <td style="padding:6px 10px;border-bottom:1px solid #eee">${g.gerNome}</td>
      <td style="padding:6px 10px;border-bottom:1px solid #eee">${g.mes}</td>
      <td style="padding:6px 10px;border-bottom:1px solid #eee">${g.nomeIndicador}</td>
      <td style="padding:6px 10px;border-bottom:1px solid #eee;text-align:center">${g.previsto}</td>
      <td style="padding:6px 10px;border-bottom:1px solid #eee;text-align:center">${g.realizado}</td>
      <td style="padding:6px 10px;border-bottom:1px solid #eee;text-align:center;font-weight:600">${pct.toFixed(1)}%</td>
    </tr>`;
  }).join('');

  const overlay = document.createElement('div');
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;display:flex;align-items:center;justify-content:center;';
  overlay.innerHTML = `
    <div style="background:#fff;border-radius:10px;max-width:800px;width:90%;max-height:80vh;overflow:auto;padding:24px;">
      <h3 style="margin:0 0 4px">Prévia da importação — ${nomeArquivo}</h3>
      <p style="color:#666;font-size:13px;margin:0 0 16px">${prontos.length} lançamento(s) de indicador serão gravados/atualizados. Nada foi salvo ainda.</p>
      <table style="width:100%;border-collapse:collapse;font-size:13px">
        <thead><tr style="background:#f5f5f5">
          <th style="padding:6px 10px;text-align:left">Gerência</th>
          <th style="padding:6px 10px;text-align:left">Mês</th>
          <th style="padding:6px 10px;text-align:left">Frequência</th>
          <th style="padding:6px 10px">Previsto</th>
          <th style="padding:6px 10px">Realizado</th>
          <th style="padding:6px 10px">%</th>
        </tr></thead>
        <tbody>${linhasHtml}</tbody>
      </table>
      <div style="text-align:right;margin-top:16px">
        <button id="btn-cancelar-previa" style="padding:8px 16px;border-radius:6px;border:1px solid #ccc;background:#fff;cursor:pointer;margin-right:8px">Cancelar</button>
        <button id="btn-confirmar-previa" style="padding:8px 16px;border-radius:6px;border:none;background:#07583C;color:#fff;cursor:pointer">Confirmar e Gravar</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  document.getElementById('btn-cancelar-previa').onclick = () => overlay.remove();
  document.getElementById('btn-confirmar-previa').onclick = async () => {
    const btn = document.getElementById('btn-confirmar-previa');
    btn.disabled = true; btn.textContent = 'Gravando...';
    try {
      const resumo = await gravarImportacaoWecheck(prontos, familiaIndicadores);
      overlay.remove();
      alert('Importação concluída.\n' + resumo.ok + ' lançamento(s) atualizado(s) com sucesso.' +
        (resumo.erros.length ? '\n' + resumo.erros.length + ' com erro (veja o console).' : ''));
      if (resumo.erros.length) console.error('Erros na importação:', resumo.erros);
      // Se a tela de lançamento estiver aberta, recarrega os dados na tela
      if (typeof onPeriodoLancarChange === 'function') onPeriodoLancarChange();
    } catch (err) {
      alert('Erro ao gravar: ' + err.message);
      btn.disabled = false; btn.textContent = 'Confirmar e Gravar';
    }
  };
}

// Grava de fato: para cada (gerência, mês), atualiza SÓ os itens dos indicadores
// que vieram da planilha (preserva outros indicadores já lançados manualmente),
// e recalcula a pontuação da gerência com TODOS os itens daquele lançamento.
// `familiaIndicadores` (opcional): nomes de TODOS os indicadores que essa planilha
// PODE gerar (ex: 1ª/2ª quinzena, trimestral, semana 1-4) — usado só pra limpar
// pendências antigas por completo, mesmo quando um desses tipos não aparece mais
// na planilha atual (ex: pendência de "trimestral" que já foi resolvida e saiu do
// relatório). Sem isso, cada tipo só era limpo quando aparecia de novo na planilha,
// e pendência de um tipo "sumido" ficava presa pra sempre. Sem esse parâmetro,
// mantém o comportamento antigo (limpa só os tipos presentes nesse lote).
async function gravarImportacaoWecheck(prontos, familiaIndicadores) {
  // Resolve o safra_id de cada linha pela própria planilha (ANO/SAFRA, ex: "2026/2027"),
  // comparando com ano_ini/ano_fim cadastrados em `safras` — não depende de nenhum
  // campo da tela (sel-safra só existe na tela de Lançamento; o import pode ser feito
  // de qualquer tela).
  const { data: safrasBanco } = await sb.from('safras').select('id,nome,ano_ini,ano_fim');
  const acharSafraId = safraTxt => {
    const m = (safraTxt || '').match(/(\d{4})\s*\/\s*(\d{4})/);
    if (!m) return null;
    const ini = parseInt(m[1], 10), fim = parseInt(m[2], 10);
    const s = (safrasBanco || []).find(s => s.ano_ini === ini && s.ano_fim === fim);
    return s ? s.id : null;
  };

  const porLancamento = {};
  const semSafra = [];
  prontos.forEach(g => {
    const safraId = acharSafraId(g.safraTxt);
    if (!safraId) { semSafra.push(g); return; }
    const chave = g.gerId + '|' + safraId + '|' + g.mes;
    if (!porLancamento[chave]) porLancamento[chave] = { gerId: g.gerId, safraId, mes: g.mes, itens: [] };
    porLancamento[chave].itens.push({ indicador_id: g.indicadorId, previsto: g.previsto, realizado: g.realizado, peso: g.peso, pessoas: g.pessoas || [] });
  });

  if (semSafra.length) {
    console.warn(semSafra.length + ' grupo(s) sem safra reconhecida (confira a coluna ANO/SAFRA na planilha):', semSafra);
  }

  // Se veio a família completa de indicadores possíveis, resolve os IDs uma vez só
  // (fora do loop) pra usar na limpeza de pendências de cada lançamento.
  let idsFamiliaCompleta = null;
  if (familiaIndicadores && familiaIndicadores.length) {
    const { data: indsFam } = await sb.from('indicadores').select('id,nome').in('nome', familiaIndicadores);
    idsFamiliaCompleta = (indsFam || []).map(i => i.id);
  }

  let ok = 0; const erros = [];

  for (const chave in porLancamento) {
    const grupo = porLancamento[chave];
    try {
      // 1. Acha ou cria o lançamento do mês/gerência/safra
      const { data: ex } = await sb.from('lancamentos').select('id')
        .eq('gerencia_id', grupo.gerId).eq('safra_id', grupo.safraId).eq('mes', grupo.mes).limit(1);
      let lancId = ex?.[0]?.id || null;
      if (!lancId) {
        const { data: ins, error: eIns } = await sb.from('lancamentos').insert({
          gerencia_id: grupo.gerId, safra_id: grupo.safraId, mes: grupo.mes, periodo: grupo.mes,
          atualizado_em: new Date().toISOString()
        }).select('id');
        if (eIns) throw eIns;
        lancId = ins?.[0]?.id;
      }

      // 2. Remove só os itens dos indicadores que estamos atualizando (preserva os demais)
      const idsIndicadores = grupo.itens.map(it => it.indicador_id);
      await sb.from('lancamento_itens').delete().eq('lancamento_id', lancId).in('indicador_id', idsIndicadores);
      const novasLinhas = grupo.itens.map(it => ({
        lancamento_id: lancId, indicador_id: it.indicador_id,
        previsto: it.previsto, realizado: it.realizado
      }));
      const { error: eItens } = await sb.from('lancamento_itens').insert(novasLinhas);
      if (eItens) throw eItens;

      // 2b. Grava o detalhe por pessoa (nome, cargo, status) — pra dar pra ver
      // "quem não fez" depois, sem precisar abrir a planilha anexada.
      await sb.from('lancamento_pendencias').delete().eq('lancamento_id', lancId).in('indicador_id', idsFamiliaCompleta || idsIndicadores);
      const linhasPessoas = [];
      grupo.itens.forEach(it => {
        (it.pessoas || []).forEach(p => {
          linhasPessoas.push({
            lancamento_id: lancId, indicador_id: it.indicador_id,
            nome: p.nome, cargo: p.cargo, matricula: p.matricula, status: p.status
          });
        });
      });
      if (linhasPessoas.length) {
        const { error: ePess } = await sb.from('lancamento_pendencias').insert(linhasPessoas);
        if (ePess) console.warn('Não consegui gravar o detalhe por pessoa (itens de previsto/realizado gravaram normal):', ePess.message);
      }

      // 3. Recalcula a pontuação da gerência usando TODOS os itens do lançamento
      const { data: todosItens } = await sb.from('lancamento_itens').select('*').eq('lancamento_id', lancId);
      const indsGer = await getIndsGerencia(grupo.gerId, grupo.safraId);
      const pg = calcPontGer(todosItens || [], indsGer || []);

      const { aud, mediaDir } = await recalcularAuditoriaEMediaDiretoria(grupo.gerId, grupo.mes, grupo.safraId, pg);
      const { data: lancAtual } = await sb.from('lancamentos').select('ajuste_pontos').eq('id', lancId).limit(1);
      const aj = lancAtual?.[0]?.ajuste_pontos || 0;
      const indBase = calcIndice(pg, mediaDir, aud, 0);
      const indFinal = calcIndice(pg, mediaDir, aud, aj);

      await sb.from('lancamentos').update({
        pontuacao_gerencia: pg, media_diretoria: mediaDir, nota_auditoria: aud,
        indice_base: indBase, indice_prevencao: indFinal,
        atualizado_em: new Date().toISOString()
      }).eq('id', lancId);

      ok++;
    } catch (err) {
      erros.push({ chave, erro: err.message });
    }
  }
  return { ok, erros };
}

// ===== Importação de planilha WeCheck Observações -> lançamentos reais no IP =====
// Reaproveita as funções genéricas já carregadas pelo importador de Inspeção
// (campo, montarMes, normaliza, baseNomeGerencia, SINONIMOS_UNIDADE, ALIASES_GERENCIA,
// calcPontGer, calcIndice) — não redeclara nada disso aqui.

// baseNomeGerencia não é global (só existe dentro do importador de Inspeção), então
// repete aqui a mesma lógica: tira sufixo "- JB"/"- PB" e o prefixo "Gerência".
function baseNomeGerencia(nome) {
  return (nome || '').toString().trim()
    .replace(/\s*-\s*(JB|PB)\s*$/i, '')
    .replace(/^ger[eê]ncia\s+/i, '');
}

const NOME_IND_OBS_MENSAL     = 'Nº de Observações Comportamentais - Mensal';
const NOME_IND_OBS_QUINZENAL  = 'Nº de Observações Comportamentais - Quinzenal'; // 1 indicador só (soma as 2 quinzenas)
const NOME_IND_OBS_TRIMESTRAL = 'Nº de Observações Comportamentais - Trimestral';
const NOME_IND_OBS_SEMANA = {
  1: 'Nº de Observações Comportamentais - Semana 1',
  2: 'Nº de Observações Comportamentais - Semana 2',
  3: 'Nº de Observações Comportamentais - Semana 3',
  4: 'Nº de Observações Comportamentais - Semana 4'
};

function acharIndicadorObsDaLinha(freq, semanaLinha) {
  const f = normaliza(freq);
  if (f === 'MENSAL') return NOME_IND_OBS_MENSAL;
  if (f === 'QUINZENAL') return NOME_IND_OBS_QUINZENAL; // ignora a coluna Quinzena de propósito — soma as 2
  if (f === 'TRIMESTRAL') return NOME_IND_OBS_TRIMESTRAL;
  if (f === 'SEMANAL') {
    const m = (semanaLinha || '').toString().match(/(\d+)/);
    const num = m ? parseInt(m[1], 10) : null;
    if (num && NOME_IND_OBS_SEMANA[num]) return NOME_IND_OBS_SEMANA[num];
  }
  return null;
}

async function importarPlanilhaWecheckObservacoes(evento) {
  const arquivos = Array.from(evento.target.files || []);
  if (!arquivos.length) return;

  try {
    const todasLinhas = [];
    for (const arquivo of arquivos) {
      const buffer = await arquivo.arrayBuffer();
      const wb = XLSX.read(new Uint8Array(buffer), { type: 'array' });
      wb.SheetNames.forEach(nomeAba => {
        const linhasAba = XLSX.utils.sheet_to_json(wb.Sheets[nomeAba], { defval: null });
        todasLinhas.push(...linhasAba);
      });
    }

    const grupos = {};
    const linhasIgnoradas = [];

    todasLinhas.forEach(l => {
      const gerNome = (campo(l, ['GERENCIA']) || '').trim();
      const unidadeNome = (campo(l, ['UNIDADE']) || '').trim();
      const mes = montarMes(l);
      const safraTxt = (campo(l, ['ANO/SAFRA', 'Ano Safra', 'ANO_SAFRA', 'SAFRA']) || '').toString().trim();
      const freq = campo(l, ['FREQUENCIA', 'Frequência']);
      if (!gerNome || !unidadeNome || !mes || !freq) { linhasIgnoradas.push({ gerNome, unidadeNome, mes, freq }); return; }

      const semanaLinha = campo(l, ['SEMANA', 'Semana']);
      const nomeIndicador = acharIndicadorObsDaLinha(freq, semanaLinha);
      if (!nomeIndicador) { linhasIgnoradas.push({ gerNome, unidadeNome, mes, freq, semanaLinha }); return; }

      const meta = parseFloat(campo(l, ['META', 'Meta'])) || 0;
      const real = parseFloat(campo(l, ['REALIZADO', 'Realizado'])) || 0;
      const chave = gerNome + '|' + unidadeNome + '|' + mes + '|' + nomeIndicador;
      if (!grupos[chave]) grupos[chave] = { gerNome, unidadeNome, mes, safraTxt, nomeIndicador, previsto: 0, realizado: 0, pessoas: [] };
      grupos[chave].previsto += meta;
      grupos[chave].realizado += real;
      grupos[chave].pessoas.push({
        nome: (campo(l, ['NOME']) || '').toString().trim(),
        cargo: (campo(l, ['CARGO']) || '').toString().trim(),
        matricula: (campo(l, ['MATRICULA', 'Matrícula']) || '').toString().trim(),
        status: (campo(l, ['STATUS']) || '').toString().replace(/^●\s*/, '').trim()
      });
    });

    if (linhasIgnoradas.length) console.warn(linhasIgnoradas.length + ' linha(s) ignorada(s):', linhasIgnoradas.slice(0, 20));

    const listaGrupos = Object.values(grupos);
    if (!listaGrupos.length) {
      alert('Não encontrei nenhuma linha válida. Confira GERENCIA, UNIDADE, MES/ANO-SAFRA, FREQUENCIA, META, REALIZADO — e, pra Semanal, a coluna SEMANA.');
      return;
    }

    const [{ data: gers }, { data: unids }, { data: inds }] = await Promise.all([
      sb.from('gerencias').select('id,nome,unidade_id').eq('ativo', true),
      sb.from('unidades').select('id,nome'),
      sb.from('indicadores').select('id,nome,tipo,peso').eq('ativo', true)
    ]);

    const acharUnidadeId = nomeExport => {
      const norm = normaliza(nomeExport);
      const alvo = SINONIMOS_UNIDADE[norm] || nomeExport;
      const u = (unids || []).find(u => normaliza(u.nome) === normaliza(alvo));
      return u ? u.id : null;
    };
    const acharGerId = (gerNomeOriginal, unidadeNome) => {
      const apelido = ALIASES_GERENCIA[normaliza(gerNomeOriginal)];
      const gerNome = apelido || gerNomeOriginal;
      const base = normaliza(baseNomeGerencia(gerNome));
      const unidadeId = acharUnidadeId(unidadeNome);
      if (unidadeId) {
        const c1 = (gers || []).filter(g => normaliza(baseNomeGerencia(g.nome)) === base && g.unidade_id === unidadeId);
        if (c1.length === 1) return { id: c1[0].id };
        if (c1.length > 1) return { erro: 'gerência ambígua (' + c1.length + ' registros nome+unidade)' };
      }
      const c2 = (gers || []).filter(g => normaliza(baseNomeGerencia(g.nome)) === base);
      if (c2.length === 1) return { id: c2[0].id };
      if (c2.length > 1) return { erro: 'gerência ambígua (' + c2.length + ' registros só de nome, unidade "' + unidadeNome + '" não bateu com nenhum)' };
      return { erro: 'gerência não encontrada' };
    };
    const acharIndicadorPorNome = nome => (inds || []).find(i => normaliza(i.nome) === normaliza(nome)) || null;

    const prontosBrutos = [];
    const semMatch = [];
    listaGrupos.forEach(gr => {
      const resGer = acharGerId(gr.gerNome, gr.unidadeNome);
      const ind = acharIndicadorPorNome(gr.nomeIndicador);
      if (resGer.erro || !ind) { semMatch.push({ ...gr, erroGer: resGer.erro, ind }); return; }
      prontosBrutos.push({ ...gr, gerId: resGer.id, indicadorId: ind.id, peso: ind.peso });
    });

    // Gerências corporativas (JB/PB) podem aparecer 2x (leitura por Jaboticabal e por
    // Pereira Barreto) resolvendo pro mesmo gerId — soma em vez de duplicar.
    const mesclados = {};
    prontosBrutos.forEach(p => {
      const chave = p.gerId + '|' + p.safraTxt + '|' + p.mes + '|' + p.indicadorId;
      if (!mesclados[chave]) mesclados[chave] = { ...p };
      else {
        mesclados[chave].previsto += p.previsto;
        mesclados[chave].realizado += p.realizado;
        mesclados[chave].pessoas = (mesclados[chave].pessoas || []).concat(p.pessoas || []);
      }
    });
    const prontos = Object.values(mesclados);

    if (semMatch.length) {
      const detalhe = semMatch.slice(0, 10).map(s =>
        `- ${s.gerNome} (${s.unidadeNome}) / ${s.nomeIndicador} (${s.erroGer || ''}${s.erroGer && !s.ind ? ' e ' : ''}${!s.ind ? 'indicador não encontrado' : ''})`
      ).join('\n');
      const seguir = confirm(
        'Não encontrei correspondência para ' + semMatch.length + ' grupo(s):\n\n' + detalhe +
        (semMatch.length > 10 ? '\n... e mais ' + (semMatch.length - 10) : '') +
        '\n\nEsses grupos NÃO serão importados. Continuar só com os ' + prontos.length + ' que deram certo?'
      );
      if (!seguir) return;
    }
    if (!prontos.length) { alert('Nenhum grupo pôde ser importado.'); return; }

    const nomeResumo = arquivos.length === 1 ? arquivos[0].name : arquivos.length + ' arquivos selecionados';
    await mostrarPreviaImportacaoObsV2(prontos, nomeResumo);
  } catch (err) {
    console.error(err);
    alert('Erro ao ler a(s) planilha(s): ' + err.message);
  } finally {
    evento.target.value = '';
  }
}

