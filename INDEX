async function executarImportacao(chave, evento) {
  const cfg = IMPORTACOES[chave];
  const arquivos = Array.from(evento.target.files || []);
  if (!arquivos.length) return;
  const fn = window[cfg.fn];
  if (typeof fn !== 'function') { alert('Função de importação não encontrada: ' + cfg.fn); return; }

  _importAtual = chave;
  const btn = document.getElementById('btn-' + chave);
  const textoOriginal = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = '<span class="spinner"></span> Lendo...';
  registrarLog('info', cfg.titulo, 'lendo ' + (arquivos.length === 1 ? arquivos[0].name : arquivos.length + ' arquivos'));
  try {
    await fn(evento); // função original — abre a prévia e grava só após confirmação
  } catch (e) {
    registrarLog('erro', cfg.titulo, e.message || String(e));
  } finally {
    btn.disabled = false; btn.innerHTML = textoOriginal;
  }
}

