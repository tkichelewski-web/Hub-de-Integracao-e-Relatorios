    if (!ind) {
      alert('Não encontrei o indicador "' + NOME_IND_TREINAMENTO + '" cadastrado (ativo) no sistema. Cria ele antes de importar.');
      return;
    }

    const acharUnidadeId = nomeExport => {
      const norm = normaliza(nomeExport);
      const alvo = SINONIMOS_UNIDADE[norm] || nomeExport;
      const u = (unids || []).find(u => normaliza(u.nome) === normaliza(alvo));
      return u ? u.id : null;
    };
    const acharGerId = (gerNomeOriginal, unidadeNome) => {
      const apelido = ALIASES_GERENCIA[normaliza(gerNomeOriginal)];
      const gerNome = apelido || gerNomeOriginal;
      const base = normaliza(baseNomeGerencia(gerNome));
      const unidadeId = acharUnidadeId(unidadeNome);

      if (unidadeId) {
        const porNomeEUnidade = (gers || []).filter(g => normaliza(baseNomeGerencia(g.nome)) === base && g.unidade_id === unidadeId);
        if (porNomeEUnidade.length === 1) return { id: porNomeEUnidade[0].id };
        if (porNomeEUnidade.length > 1) return { erro: 'gerência ambígua (' + porNomeEUnidade.length + ' registros nome+unidade)' };
      }
      const porNome = (gers || []).filter(g => normaliza(baseNomeGerencia(g.nome)) === base);
      if (porNome.length === 1) return { id: porNome[0].id };
      if (porNome.length > 1) return { erro: 'gerência ambígua (' + porNome.length + ' registros — confira se a unidade "' + unidadeNome + '" está certa no cadastro)' };
      return { erro: 'gerência não encontrada' };
    };

    const prontosBrutos = [];
    const semMatch = [];
    listaGrupos.forEach(gr => {
      const resGer = acharGerId(gr.gerNome, gr.unidadeNome);
      if (resGer.erro) { semMatch.push({ ...gr, erroGer: resGer.erro }); return; }
      prontosBrutos.push({ ...gr, gerId: resGer.id, indicadorId: ind.id, peso: ind.peso });
    });

    // Alguns nomes da planilha (ex: Facilities/RH/Jurídico) apontam pra UMA MESMA
    // gerência no cadastro (via ALIASES_GERENCIA) — mescla por média em vez de deixar
    // 3 lançamentos conflitantes pro mesmo lugar/mês.
    const mesclados = {};
    prontosBrutos.forEach(p => {
      const chave = p.gerId + '|' + p.mes + '|' + p.safraTxt;
      if (!mesclados[chave]) mesclados[chave] = { ...p, _n: 1 };
      else {
        const m = mesclados[chave];
        m.previsto = (m.previsto * m._n + p.previsto) / (m._n + 1);
        m.realizado = (m.realizado * m._n + p.realizado) / (m._n + 1);
        m._n++;
      }
    });
    const prontos = Object.values(mesclados);

    if (semMatch.length) {
      const detalhe = semMatch.slice(0, 15).map(s => `- ${s.gerNome} (${s.unidadeNome}) — ${s.erroGer}`).join('\n');
      const seguir = confirm(
        'Não encontrei correspondência para ' + semMatch.length + ' gerência(s):\n\n' + detalhe +
        (semMatch.length > 15 ? '\n... e mais ' + (semMatch.length - 15) : '') +
        '\n\nEssas gerências NÃO serão importadas. Continuar só com as ' + prontos.length + ' que deram certo?'
      );
      if (!seguir) return;
    }
    if (!prontos.length) { alert('Nenhum grupo pôde ser importado.'); return; }

    const nomeResumo = arquivos.length === 1 ? arquivos[0].name : arquivos.length + ' arquivos selecionados';
    await mostrarPreviaImportacaoV2(prontos, nomeResumo);
  } catch (err) {
    console.error(err);
    alert('Erro ao ler a(s) planilha(s): ' + err.message +
      '\nConfira se a planilha tem as colunas UNIDADE, GERÊNCIA, MÊS, SAFRA/, PREVISTO, REALIZADO.');
  } finally {
    evento.target.value = '';
  }
}


</script>
