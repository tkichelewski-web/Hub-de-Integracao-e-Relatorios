async function coletarDadosApresentacao(safraId, mes, dirId) {
  progresso(5, 'Buscando lançamentos do mês...');
  const { data: lancs, error } = await sbSafe(() =>
    sb.from('lancamentos')
      .select('*,gerencias(id,nome,diretoria_id,unidade_id,diretorias(nome),unidades(nome))')
      .or(`mes.eq.${mes},periodo.eq.${mes}`)
  );
  if (error) throw new Error('Falha ao buscar lançamentos: ' + error.message);

  let lista = (lancs || []).filter(l => l.gerencias);
  if (dirId) lista = lista.filter(l => l.gerencias.diretoria_id === dirId);

  // Se houver mais de um lançamento da mesma gerência no mês, fica o mais recente (maior id)
  const porGer = {};
  lista.forEach(l => { if (!porGer[l.gerencia_id] || l.id > porGer[l.gerencia_id].id) porGer[l.gerencia_id] = l; });
  lista = Object.values(porGer);
  if (!lista.length) return [];

  // Itens em lotes (evita o limite de 1000 linhas por consulta do Supabase)
  progresso(15, 'Buscando indicadores lançados...');
  const ids = lista.map(l => l.id);
  const itens = [];
  for (let i = 0; i < ids.length; i += 20) {
    const lote = ids.slice(i, i + 20);
    const { data, error: e2 } = await sbSafe(() => sb.from('lancamento_itens').select('*').in('lancamento_id', lote));
    if (e2) throw new Error('Falha ao buscar itens: ' + e2.message);
    itens.push(...(data || []));
  }
  const itensPorLanc = {};
  itens.forEach(it => (itensPorLanc[it.lancamento_id] = itensPorLanc[it.lancamento_id] || []).push(it));

  // Pesos por gerência/safra (ind_gerencia_safra) — mesma função do sistema principal
  const indsPorGer = {};
  for (let i = 0; i < lista.length; i++) {
    const l = lista[i];
    progresso(20 + (i / lista.length) * 55, `Carregando pesos: ${l.gerencias.nome} (${i + 1}/${lista.length})`);
    indsPorGer[l.gerencia_id] = await getIndsGerencia(l.gerencia_id, safraId);
  }

  const wPG = Number(config?.peso_gerencia) || 0.5;
  const wMD = Number(config?.peso_diretoria) || 0.2;
  const wAUD = Number(config?.peso_auditoria) || 0.3;

  return lista.map(l => {
    const indsGer = indsPorGer[l.gerencia_id] || [];
    const itensL = (itensPorLanc[l.id] || []).map(it => ({ ...it })); // cópia: calcPontGer escreve item.pontuacao
    calcPontGer(itensL, indsGer);

    const validos = itensL.filter(it => indsGer.find(i => i.id === it.indicador_id));
    const somaPesos = validos.reduce((s, it) => s + (indsGer.find(i => i.id === it.indicador_id).peso || 0), 0);

    const linhas = validos.map(it => {
      const ind = indsGer.find(i => i.id === it.indicador_id);
      let previsto = '—', realizado = '—';
      if (ind.tipo === 'previsto_realizado') { previsto = fmtNum(it.previsto); realizado = fmtNum(it.realizado); }
      else if (ind.tipo === 'nota') realizado = fmtNum(it.nota);
      else if (ind.tipo === 'binario') realizado = it.sim_nao ? 'Sim' : 'Não';
      return {
        bloco: ind.bloco || '',
        nome: ind.nome || ('Indicador ' + it.indicador_id),
        previsto, realizado,
        ating: it.pontuacao || 0,
        peso: ind.peso || 0,
        contrib: somaPesos > 0 ? (it.pontuacao || 0) * (ind.peso || 0) / somaPesos : 0
      };
    }).sort((a, b) => (a.bloco || '').localeCompare(b.bloco || '', 'pt-BR') || a.nome.localeCompare(b.nome, 'pt-BR'));

    const pg = l.pontuacao_gerencia || 0;
    const md = l.media_diretoria;
    const mdVal = md != null ? md : pg;
    const aud = l.nota_auditoria || 0;
    const aj = l.ajuste_pontos || 0;

    // Descrição dos ajustes (mesma regra do dashboard do sistema principal)
    const eventos = extrairEventos(l);
    const pValor = { iap: -5, asa: -10, aca: -15, fatalidade: -30 };
    const pLabel = { iap: 'IAP', asa: 'ASA', aca: 'ACA', fatalidade: 'Fatalidade' };
    const partesAj = eventos.length === 0
      ? ['+5 sem acidente']
      : eventos.map(ev => `${ev.tipo === 'incidente' ? 'Inc.' : 'Acid.'} ${pLabel[ev.classe] || ev.classe} ${pValor[ev.classe] || 0}`);
    const regras = l.regras_salvas || 0;
    if (regras > 0) partesAj.push(`Regras +${Math.min(regras, 5)}`);

    return {
      gerId: l.gerencia_id,
      gerNome: l.gerencias.nome,
      dirNome: l.gerencias.diretorias?.nome || '',
      uniNome: l.gerencias.unidades?.nome || '',
      pg, mdVal, aud, aj,
      base: pg * wPG + mdVal * wMD + aud * wAUD,
      ip: l.indice_prevencao || 0,
      ajusteTexto: partesAj.join('  |  '),
      pesos: { wPG, wMD, wAUD },
      linhas,
      pgTabela: linhas.reduce((s, r) => s + r.contrib, 0)
    };
  });
}

