<style>
:root{
  --verde:#07583C; --verde-2:#0A6B4A; --lima:#B3DD64; --lima-suave:#EAF5D6;
  --fundo:#F2F5F0; --papel:#FFFFFF; --tinta:#1C2B22; --muted:#5D6F64;
  --linha:#D5E3CC; --erro:#B42318; --ok:#07583C; --aviso:#9A6B00;
  --raio:8px;
}
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{font-family:'Barlow',system-ui,-apple-system,'Segoe UI',Arial,sans-serif;background:var(--fundo);color:var(--tinta);font-size:15px;line-height:1.5}
button,select,input{font:inherit}
:focus-visible{outline:3px solid var(--lima);outline-offset:2px}
.hidden{display:none !important}

.campo{display:flex;flex-direction:column;gap:4px;margin-bottom:14px}
.campo label{font-size:13px;font-weight:600;color:var(--muted)}
.campo input,.campo select{padding:10px 12px;border:1px solid var(--linha);border-radius:6px;background:#fff;color:var(--tinta);width:100%}
.campo select:disabled{background:#f4f4f4;color:#999}
/* ── Botões ── */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 16px;border-radius:6px;border:1px solid transparent;cursor:pointer;font-weight:600;transition:background .15s}
.btn-primario{background:var(--verde);color:#fff}
.btn-primario:hover{background:var(--verde-2)}
.btn-primario:disabled{background:#8FA99A;cursor:not-allowed}
.btn-sec{background:#fff;color:var(--verde);border-color:var(--linha)}
.btn-sec:hover{border-color:var(--verde)}
.btn-sec:disabled{opacity:.6;cursor:wait}
.btn-bloco{width:100%}
.btn-grande{padding:14px 18px;font-size:16px}

/* ── Topo ── */
header.topo{background:var(--verde);color:#fff;border-bottom:4px solid var(--lima)}
.topo-inner{max-width:1280px;margin:0 auto;padding:18px 24px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.topo h1{margin:0;font-size:22px;font-weight:700;line-height:1.2}
.topo .sub{color:var(--lima);font-size:14px;font-weight:500}
.topo .usuario{margin-left:auto;display:flex;align-items:center;gap:12px;font-size:14px}

/* ── Layout ── */
main.grade{max-width:1280px;margin:0 auto;padding:24px;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:24px;align-items:start}
@media (max-width:960px){main.grade{grid-template-columns:1fr;padding:16px}}
.painel{background:var(--papel);border:1px solid var(--linha);border-radius:12px;overflow:hidden}
.painel-cab{padding:18px 22px 14px;border-bottom:1px solid var(--linha)}
.painel-cab h2{margin:0;font-size:19px;color:var(--verde);font-weight:700}
.painel-cab p{margin:4px 0 0;color:var(--muted);font-size:14px}
.painel-corpo{padding:6px 22px 22px}
#painel-ppt{position:sticky;top:16px}
@media (max-width:960px){#painel-ppt{position:static}}

/* ── Lista de importações ── */
.grupo-titulo{margin:18px 0 4px;font-size:14px;font-weight:700;color:var(--tinta)}
.grupo-desc{margin:0 0 6px;font-size:13px;color:var(--muted)}
.imp-linha{display:flex;align-items:center;gap:14px;padding:12px 0;border-bottom:1px solid var(--linha)}
.imp-linha:last-child{border-bottom:none}
.imp-info{flex:1;min-width:0}
.imp-nome{font-weight:600;font-size:15px}
.imp-dica{font-size:12.5px;color:var(--muted);overflow-wrap:anywhere}
.imp-status{font-size:12px;font-weight:600;white-space:nowrap}
.imp-status.ok{color:var(--ok)}
.imp-linha .btn{white-space:nowrap}
.imp-destaque{margin-top:18px;padding:14px 16px;border:1px solid var(--lima);background:var(--lima-suave);border-radius:var(--raio)}
.imp-destaque .imp-linha{border:none;padding:0}
@media (max-width:560px){.imp-linha{flex-wrap:wrap}.imp-linha .btn{width:100%}}

/* ── Log ── */
.log{margin-top:20px;border-top:1px solid var(--linha);padding-top:14px}
.log h3{margin:0 0 8px;font-size:14px}
.log ul{list-style:none;margin:0;padding:0;max-height:180px;overflow:auto;font-size:13px}
.log li{padding:4px 0;display:flex;gap:10px;border-bottom:1px dashed #E3EBDD}
.log li time{color:var(--muted);font-variant-numeric:tabular-nums;flex-shrink:0}
.log li.ok span{color:var(--ok);font-weight:600}
.log li.erro span{color:var(--erro);font-weight:600}
.log .vazio{color:var(--muted);font-size:13px}

/* ── Gerador ── */
.filtros{display:grid;grid-template-columns:1fr 1fr;gap:0 14px;margin-top:14px}
.filtros .campo-dir{grid-column:1 / -1}
.opcao{display:flex;align-items:center;gap:8px;font-size:14px;margin:4px 0 16px;cursor:pointer}
.opcao input{width:18px;height:18px;accent-color:var(--verde)}
.resumo-filtro{background:var(--fundo);border-radius:var(--raio);padding:12px 14px;font-size:14px;margin-bottom:16px;min-height:46px}
.resumo-filtro strong{color:var(--verde)}
.progresso{margin-top:14px;display:none}
.progresso .barra{height:8px;background:#E3EBDD;border-radius:4px;overflow:hidden}
.progresso .barra div{height:100%;width:0;background:var(--verde);transition:width .25s}
.progresso p{margin:6px 0 0;font-size:13px;color:var(--muted)}
.estrutura-slides{margin-top:18px;font-size:13px;color:var(--muted);border-top:1px solid var(--linha);padding-top:12px}
.estrutura-slides ol{margin:6px 0 0;padding-left:18px}

.spinner{width:14px;height:14px;border:2px solid currentColor;border-right-color:transparent;border-radius:50%;display:inline-block;animation:gira .7s linear infinite}
@keyframes gira{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.spinner{animation:none}.progresso .barra div{transition:none}}
