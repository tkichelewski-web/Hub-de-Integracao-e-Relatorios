  s.addText(titulo, { x: x + 0.2, y: y + 0.1, w: w - 0.3, h: 0.3, fontFace: FONTE, fontSize: 11, bold: true, color: COR.muted, margin: 0 });
  s.addText(valor, { x: x + 0.2, y: y + 0.4, w: w - 0.3, h: 0.5, fontFace: FONTE, fontSize: 26, bold: true, color: corValor || COR.tinta, margin: 0, valign: 'middle' });
  s.addText(detalhe, { x: x + 0.2, y: y + 0.92, w: w - 0.3, h: 0.36, fontFace: FONTE, fontSize: 8.5, color: COR.muted, margin: 0, valign: 'top', fit: 'shrink' });
}

function cardIP(pptx, s, g) {
  const x = 9.65, y = 1.35, w = 3.18, h = 1.35;
  const st = statusIP(g.ip);
  s.addShape(pptx.ShapeType.rect, { x, y, w, h, fill: { color: st.cor }, line: { color: st.cor } });
  s.addText('IP FINAL', { x: x + 0.2, y: y + 0.1, w: w - 0.4, h: 0.3, fontFace: FONTE, fontSize: 11, bold: true, color: 'FFFFFF', margin: 0 });
  s.addText(fmt(g.ip), { x: x + 0.2, y: y + 0.35, w: w - 0.4, h: 0.7, fontFace: FONTE, fontSize: 40, bold: true, color: 'FFFFFF', margin: 0, valign: 'middle' });
  s.addText(st.label, { x: x + 0.2, y: y + 1.0, w: w - 0.4, h: 0.28, fontFace: FONTE, fontSize: 12, bold: true, color: 'FFFFFF', margin: 0 });
}

function tabelaIndicadores(s, linhasPagina, g, ultimaPagina) {
  const hdr = t => ({ text: t, options: { bold: true, color: 'FFFFFF', fill: { color: COR.verde }, align: 'center' } });
  const rows = [[
    { text: 'Bloco', options: { bold: true, color: 'FFFFFF', fill: { color: COR.verde }, align: 'left' } },
    { text: 'Indicador', options: { bold: true, color: 'FFFFFF', fill: { color: COR.verde }, align: 'left' } },
    hdr('Previsto'), hdr('Realizado / Nota'), hdr('Atingimento'), hdr('Peso'), hdr('Pontos')
  ]];
  linhasPagina.forEach((r, i) => {
    const fill = { color: i % 2 ? COR.zebra : 'FFFFFF' };
    const corAt = r.ating >= 100 ? COR.verde : COR.atencao;
    rows.push([
      { text: r.bloco, options: { fill, color: COR.muted } },
      { text: r.nome, options: { fill } },
      { text: r.previsto, options: { fill, align: 'center' } },
      { text: r.realizado, options: { fill, align: 'center' } },
      { text: fmt(r.ating) + '%', options: { fill, align: 'center', bold: true, color: corAt } },
      { text: fmtNum(r.peso), options: { fill, align: 'center' } },
      { text: fmt(r.contrib, 2), options: { fill, align: 'center' } }
    ]);
  });
  if (ultimaPagina) {
    const f = { color: COR.totalFill };
    rows.push([
      { text: 'Pontuação da gerência', options: { fill: f, bold: true, colspan: 6, align: 'right' } },
      { text: fmt(g.pg, 2), options: { fill: f, bold: true, align: 'center', color: COR.verde } }
    ]);
  }
  s.addTable(rows, {
    x: 0.5, y: 2.95, w: 12.33,
    colW: [1.6, 4.4, 1.15, 1.45, 1.35, 0.95, 1.43],
    rowH: 0.32, fontFace: FONTE, fontSize: 10, color: COR.tinta, valign: 'middle',
    border: { type: 'solid', pt: 0.5, color: COR.linha }, margin: [2, 6, 2, 6]
  });
}

function slidesGerencia(pptx, g, info) {
  const paginas = [];
  for (let i = 0; i < g.linhas.length; i += LINHAS_POR_SLIDE) paginas.push(g.linhas.slice(i, i + LINHAS_POR_SLIDE));
  if (!paginas.length) paginas.push([]);

  paginas.forEach((pag, idx) => {
    const s = pptx.addSlide();
    cabecalhoGerencia(pptx, s, g, info, idx > 0);

    const { wPG, wMD, wAUD } = g.pesos;
    const pct = w => Math.round(w * 100) + '%';
    cardKPI(pptx, s, 0.5, 2.95, 'Pontuação base', fmt(g.base),
      `Gerência ${fmt(g.pg)} × ${pct(wPG)} + Diretoria ${fmt(g.mdVal)} × ${pct(wMD)} + Auditoria ${fmt(g.aud)} × ${pct(wAUD)}`);
    cardKPI(pptx, s, 3.57, 2.95, 'Ajustes', (g.aj > 0 ? '+' : '') + fmt(g.aj), g.ajusteTexto,
      g.aj >= 0 ? COR.verde : COR.atencao);
    cardKPI(pptx, s, 6.64, 2.85, 'Nota de auditoria', fmt(g.aud), `Peso de ${pct(wAUD)} no índice`);
    cardIP(pptx, s, g);

    if (!pag.length) {
      s.addText('Nenhum indicador lançado para esta gerência no mês.', {
        x: 0.5, y: 3.3, w: 12.33, h: 0.6, fontFace: FONTE, fontSize: 14, color: COR.muted, align: 'center',
        fill: { color: COR.zebra }
      });
    } else {
      tabelaIndicadores(s, pag, g, idx === paginas.length - 1);
    }
  });
}

async function gerarPowerPoint() {
  const btn = document.getElementById('btn-gerar');
  const safraId = parseInt(document.getElementById('f-safra').value) || 0;
  const mes = document.getElementById('f-mes').value;
  const dirId = parseInt(document.getElementById('f-dir').value) || 0;
  if (!safraId || !mes) { alert('Selecione safra e mês.'); return; }
  if (typeof PptxGenJS === 'undefined') { alert('A biblioteca PptxGenJS não carregou. Verifique a conexão e recarregue a página.'); return; }

  btn.disabled = true; btn.innerHTML = '<span class="spinner"></span> Gerando...';
  try {
    const dados = await coletarDadosApresentacao(safraId, mes, dirId);
    if (!dados.length) {
      progresso(100, 'Nenhuma gerência com lançamento para esse filtro. Importe os dados e tente de novo.');
      return;
    }

    // Ordenação: diretoria (A-Z) e, dentro dela, IP desc ou nome da gerência
    const porIP = document.getElementById('f-ordem-ip').checked;
    dados.sort((a, b) =>
      a.dirNome.localeCompare(b.dirNome, 'pt-BR') ||
      (porIP ? b.ip - a.ip : a.gerNome.localeCompare(b.gerNome, 'pt-BR')));

    const safra = safrasData.find(s => s.id === safraId);
    const dir = estrutura.diretorias.find(d => d.id === dirId);
    const info = {
      mesNome: nomeDoMes(mes),
      dirNome: dir ? dir.nome : 'Todas as Diretorias',
      safraNome: safra ? safra.nome : '',
      nGer: dados.length,
      media: dados.reduce((s, g) => s + g.ip, 0) / dados.length
    };

    progresso(80, 'Montando os slides...');
    const pptx = new PptxGenJS();
    pptx.layout = 'LAYOUT_WIDE'; // 13,33 x 7,5 pol (16:9)
    pptx.author = 'SSMA';
    pptx.company = 'Usina Santa Adélia — SSMA';
    pptx.title = `Índice de Prevenção - VIDAS — ${info.mesNome} — ${info.dirNome}`;

    slideCapa(pptx, info);
    dados.forEach(g => slidesGerencia(pptx, g, info));

    progresso(92, 'Salvando o arquivo...');
    const slug = t => normaliza(t).replace(/[^A-Z0-9]+/g, '_').replace(/^_|_$/g, '');
    const nomeArq = `IP_VIDAS_${mes}_${dir ? slug(dir.nome) : 'TODAS'}.pptx`;
    await pptx.writeFile({ fileName: nomeArq });
    progresso(100, `Pronto: ${nomeArq} (${dados.length} gerência(s)).`);
    registrarLog('ok', 'Apresentação', nomeArq + ' gerada');
  } catch (e) {
    console.error(e);
    progresso(100, 'Erro: ' + (e.message || e));
    registrarLog('erro', 'Apresentação', e.message || String(e));
  } finally {
    btn.disabled = false; btn.textContent = 'Gerar PowerPoint (.pptx)';
  }
}

