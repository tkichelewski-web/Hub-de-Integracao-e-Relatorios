async function gravarImportacaoFechamentoMensal(prontos, escolha) {
  let ok = 0; const erros = [];

  for (const g of prontos) {
    try {
      const { data: ex } = await sb.from('lancamentos').select('id')
        .eq('gerencia_id', g.gerId).eq('safra_id', escolha.safraId).eq('mes', escolha.mes).limit(1);
      let lancId = ex?.[0]?.id || null;
      if (!lancId) {
        const { data: ins, error: eIns } = await sb.from('lancamentos').insert({
          gerencia_id: g.gerId, safra_id: escolha.safraId, mes: escolha.mes, periodo: escolha.mes,
          ajuste_pontos: g.ajuste, atualizado_em: new Date().toISOString()
        }).select('id');
        if (eIns) throw eIns;
        lancId = ins?.[0]?.id;
      } else {
        await sb.from('lancamentos').update({ ajuste_pontos: g.ajuste }).eq('id', lancId);
      }

      const indIds = g.itens.map(it => it.indicador_id);
      await sb.from('lancamento_itens').delete().eq('lancamento_id', lancId).in('indicador_id', indIds);
      const { error: eItens } = await sb.from('lancamento_itens').insert(
        g.itens.map(it => ({ lancamento_id: lancId, indicador_id: it.indicador_id, previsto: it.previsto, realizado: it.realizado }))
      );
      if (eItens) throw eItens;

      const { data: todosItens } = await sb.from('lancamento_itens').select('*').eq('lancamento_id', lancId);
      const indsGer = await getIndsGerencia(g.gerId, escolha.safraId);
      const pg = calcPontGer(todosItens || [], indsGer || []);

      const { aud, mediaDir } = await recalcularAuditoriaEMediaDiretoria(g.gerId, escolha.mes, escolha.safraId, pg);
      const indBase = calcIndice(pg, mediaDir, aud, 0);
      const indFinal = calcIndice(pg, mediaDir, aud, g.ajuste);

      await sb.from('lancamentos').update({
        pontuacao_gerencia: pg, media_diretoria: mediaDir, nota_auditoria: aud,
        indice_base: indBase, indice_prevencao: indFinal,
        atualizado_em: new Date().toISOString()
      }).eq('id', lancId);

      ok++;
    } catch (err) {
      erros.push({ gerencia: g.gerNome, erro: err.message });
    }
  }
  return { ok, erros };
}

// ===== Importação de Exames Periódicos -> lançamento real no IP =====
// Planilha por pessoa (NOME_COLABORADOR, GERENCIA, Mes Nome, Safra "26/27", Total Previsto
// Inicial, Total Realizado, STATUS_DASHBOARD). Sem coluna de Unidade — os nomes de gerência
// seguem o mesmo padrão dos exports WeCheck, então reaproveita ALIASES_GERENCIA/
// SINONIMOS_UNIDADE/baseNomeGerencia já carregados, e a gravação genérica
// gravarImportacaoWecheck / mostrarPreviaImportacaoV2 (usadas pelo importador de Inspeções).

const NOME_IND_EXAME_PERIODICO = 'Exames Periódicos';

// "26/27" -> "2026/2027", pro mesmo formato que anoDaSafraParaMes/acharSafraId esperam.
function normalizarSafraCurta(txt) {
  const s = (txt || '').toString().trim();
  const m2 = s.match(/^(\d{2})\s*\/\s*(\d{2})$/);
  if (m2) return '20' + m2[1] + '/20' + m2[2];
  if (/\d{4}\s*\/\s*\d{4}/.test(s)) return s;
  return s;
}

async function importarPlanilhaExamesPeriodicos(evento) {
  const arquivos = Array.from(evento.target.files || []);
  if (!arquivos.length) return;

  try {
    const todasLinhas = [];
    for (const arquivo of arquivos) {
      const buffer = await arquivo.arrayBuffer();
      const wb = XLSX.read(new Uint8Array(buffer), { type: 'array' });
      wb.SheetNames.forEach(nomeAba => {
        const linhasAba = XLSX.utils.sheet_to_json(wb.Sheets[nomeAba], { defval: null });
        todasLinhas.push(...linhasAba);
      });
    }

    const grupos = {};
    const linhasIgnoradas = [];

    todasLinhas.forEach(lBruta => {
      const l = linhaComChavesTrimadas(lBruta);
      const gerNome = (campo(l, ['GERENCIA', 'Gerência']) || '').toString().trim();
      const unidadeNome = (campo(l, ['UNIDADE', 'Unidade']) || '').toString().trim();
      const mesTexto = (campo(l, ['Mes Nome', 'Mês', 'MES', 'MES_NOME', 'Mes_Nome']) || '').toString().trim().toLowerCase();
      const num = MESES_PT[mesTexto];
      const safraTxt = normalizarSafraCurta(campo(l, ['Safra', 'ANO/SAFRA', 'Ano Safra', 'ANO_SAFRA']));
      const ano = num ? anoDaSafraParaMes(safraTxt, parseInt(num, 10)) : null;
      const mes = (ano && num) ? (ano + '-' + num) : null;

      if (!gerNome || !mes) { linhasIgnoradas.push({ gerNome, mesTexto, safraTxt }); return; }

      const previsto = parseFloat(campo(l, ['Total Previsto Inicial', 'Previsto'])) || 0;
      const realizado = parseFloat(campo(l, ['Total Realizado', 'Realizado'])) || 0;
      const chave = gerNome + '|' + unidadeNome + '|' + mes + '|' + safraTxt;
      if (!grupos[chave]) grupos[chave] = { gerNome, unidadeNome, mes, safraTxt, nomeIndicador: NOME_IND_EXAME_PERIODICO, previsto: 0, realizado: 0, pessoas: [] };
      grupos[chave].previsto += previsto;
      grupos[chave].realizado += realizado;
      grupos[chave].pessoas.push({
        nome: (campo(l, ['NOME_COLABORADOR', 'Colaborador']) || '').toString().trim(),
        cargo: '',
        matricula: '',
        status: (campo(l, ['STATUS_DASHBOARD', 'Status']) || '').toString().trim()
      });
    });

    if (linhasIgnoradas.length) console.warn(linhasIgnoradas.length + ' linha(s) ignorada(s) (sem GERENCIA/Mês/Safra reconhecível):', linhasIgnoradas.slice(0, 20));

    const listaGrupos = Object.values(grupos);
    if (!listaGrupos.length) {
      alert('Não encontrei nenhuma linha válida. Confira se a planilha tem as colunas GERENCIA, "Mes Nome", Safra, "Total Previsto Inicial", "Total Realizado".');
      return;
    }

    const [{ data: gers }, { data: unids }, { data: inds }] = await Promise.all([
      sb.from('gerencias').select('id,nome,unidade_id').eq('ativo', true),
      sb.from('unidades').select('id,nome'),
      sb.from('indicadores').select('id,nome,tipo,peso').eq('ativo', true)
    ]);

    const ind = (inds || []).find(i => normaliza(i.nome) === normaliza(NOME_IND_EXAME_PERIODICO));
    if (!ind) {
      alert('Não encontrei o indicador "' + NOME_IND_EXAME_PERIODICO + '" cadastrado (ativo) no sistema. Cria ele antes de importar.');
      return;
    }

    const acharUnidadeId = nomeExport => {
      const norm = normaliza(nomeExport);
      const alvo = SINONIMOS_UNIDADE[norm] || nomeExport;
      const u = (unids || []).find(u => normaliza(u.nome) === normaliza(alvo));
      return u ? u.id : null;
    };
    const acharGerId = (gerNomeOriginal, unidadeNome) => {
      const apelido = ALIASES_GERENCIA[normaliza(gerNomeOriginal)];
      const gerNome = apelido || gerNomeOriginal;
      const base = normaliza(baseNomeGerencia(gerNome));
      const unidadeId = acharUnidadeId(unidadeNome);

      if (unidadeId) {
        const porNomeEUnidade = (gers || []).filter(g => normaliza(baseNomeGerencia(g.nome)) === base && g.unidade_id === unidadeId);
        if (porNomeEUnidade.length === 1) return { id: porNomeEUnidade[0].id };
        if (porNomeEUnidade.length > 1) return { erro: 'gerência ambígua (' + porNomeEUnidade.length + ' registros nome+unidade)' };
      }
      const porNome = (gers || []).filter(g => normaliza(baseNomeGerencia(g.nome)) === base);
      if (porNome.length === 1) return { id: porNome[0].id };
      if (porNome.length > 1) return { erro: 'gerência ambígua (' + porNome.length + ' registros — a planilha não diz JB ou PB pra essa gerência)' };
      return { erro: 'gerência não encontrada' };
    };

    const prontos = [];
    const semMatch = [];
    listaGrupos.forEach(gr => {
      const resGer = acharGerId(gr.gerNome, gr.unidadeNome);
      if (resGer.erro) { semMatch.push({ ...gr, erroGer: resGer.erro }); return; }
      prontos.push({ ...gr, gerId: resGer.id, indicadorId: ind.id, peso: ind.peso });
    });

    if (semMatch.length) {
      const detalhe = semMatch.slice(0, 10).map(s => `- ${s.gerNome} — ${s.erroGer}`).join('\n');
      const seguir = confirm(
        'Não encontrei correspondência para ' + semMatch.length + ' gerência(s):\n\n' + detalhe +
        (semMatch.length > 10 ? '\n... e mais ' + (semMatch.length - 10) : '') +
        '\n\nEssas gerências NÃO serão importadas. Continuar só com as ' + prontos.length + ' que deram certo?'
      );
      if (!seguir) return;
    }
    if (!prontos.length) { alert('Nenhum grupo pôde ser importado.'); return; }

    const nomeResumo = arquivos.length === 1 ? arquivos[0].name : arquivos.length + ' arquivos selecionados';
    await mostrarPreviaImportacaoV2(prontos, nomeResumo);
  } catch (err) {
    console.error(err);
    alert('Erro ao ler a(s) planilha(s): ' + err.message +
      '\nConfira se a planilha tem as colunas GERENCIA, "Mes Nome", Safra, "Total Previsto Inicial", "Total Realizado".');
  } finally {
    evento.target.value = '';
  }
}

// ===== Importação de Atendimento Matriz de Treinamento -> lançamento real no IP =====
// Planilha já vem 1 linha por gerência/mês (não por pessoa), com UNIDADE explícita —
// inclusive o valor combinado "JB/PB" pra gerências que têm um único registro pras duas
// unidades. Reaproveita o mesmo acharGerId/gravarImportacaoWecheck dos outros importadores.

const NOME_IND_TREINAMENTO = 'Atendimento Matriz de Treinamento 70%';

async function importarPlanilhaTreinamento(evento) {
  const arquivos = Array.from(evento.target.files || []);
  if (!arquivos.length) return;

  try {
    const todasLinhas = [];
    for (const arquivo of arquivos) {
      const buffer = await arquivo.arrayBuffer();
      const wb = XLSX.read(new Uint8Array(buffer), { type: 'array' });
      wb.SheetNames.forEach(nomeAba => {
        todasLinhas.push(...XLSX.utils.sheet_to_json(wb.Sheets[nomeAba], { defval: null }));
      });
    }

    const grupos = {};
    const linhasIgnoradas = [];

    todasLinhas.forEach(lBruta => {
      const l = linhaComChavesTrimadas(lBruta);
      const unidadeNome = (campo(l, ['UNIDADE', 'Unidade']) || '').toString().trim();
      const gerNome = (campo(l, ['GERÊNCIA', 'GERENCIA', 'Gerência']) || '').toString().trim();
      const mesTexto = (campo(l, ['MÊS', 'MES', 'Mês']) || '').toString().trim().toLowerCase();
      const num = MESES_PT[mesTexto];
      const safraTxt = normalizarSafraCurta(campo(l, ['SAFRA/', 'Safra', 'ANO/SAFRA', 'Ano Safra']));
      const ano = num ? anoDaSafraParaMes(safraTxt, parseInt(num, 10)) : null;
      const mes = (ano && num) ? (ano + '-' + num) : null;

