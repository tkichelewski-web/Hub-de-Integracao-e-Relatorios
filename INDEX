<script>
// ═════════════════════════════════════════════════════════════════
// NÚCLEO REAPROVEITADO DO SISTEMA PRINCIPAL (copiado sem alterações):
// cliente Supabase, safras, carga de config/estrutura/indicadores,
// eventos/ajustes, cálculo de pontuação e IP, auditoria/média da diretoria,
// pesos por gerência, withTimeout e sbSafe.
// ═════════════════════════════════════════════════════════════════
const { createClient } = supabase;
const SB_URL = 'https://umpctnchhmyvpjwxllaj.supabase.co';
const SB_KEY = 'sb_publishable_lxiF04jATB1HMLINX-FvOg_3JOjXxrQ';
const SB_OPTS = { auth: { persistSession:true, storageKey:'sistema-ip-auth', flowType:'implicit',
                          autoRefreshToken:true, detectSessionInUrl:true,
                          storage: window.localStorage } };
let sb = createClient(SB_URL, SB_KEY, SB_OPTS);

// Recria o cliente Supabase quando a sessão fica inválida (token expirado em query longa).
// Isso garante que queries novas não herdem estado corrompido de um cliente "zombie".
function _recrearClienteSb() {
  try {
    sb = createClient(SB_URL, SB_KEY, SB_OPTS);
    console.log('Cliente Supabase recriado com sucesso.');
  } catch(e) {
    console.error('Falha ao recriar cliente Supabase:', e.message);
  }
}

const MESES_SAFRA = [
  {num:'04',nome:'Abril'},{num:'05',nome:'Maio'},{num:'06',nome:'Junho'},
  {num:'07',nome:'Julho'},{num:'08',nome:'Agosto'},{num:'09',nome:'Setembro'},
  {num:'10',nome:'Outubro'},{num:'11',nome:'Novembro'},{num:'12',nome:'Dezembro'},
  {num:'01',nome:'Janeiro'},{num:'02',nome:'Fevereiro'},{num:'03',nome:'Março'}
];

function getMesesSafra(safra) {
  if(!safra) return [];
  return MESES_SAFRA.map(m => {
    const ano = parseInt(m.num) >= 4 ? safra.ano_ini : safra.ano_fim;
    return { val: `${ano}-${m.num}`, nome: `${m.nome}/${ano}` };
  });
}

// Meses futuros (depois do mês atual) não têm apuração possível ainda — mesmo que
// exista uma linha de lançamento em branco pra eles no banco (pontuacao_gerencia=0
// "de verdade", não null, criada sem querer), eles não devem aparecer no Acumulado
// nem entrar na média. Compara sempre com a data real de hoje.

async function carregarConfig(){
  const{data}=await sb.from('config').select('*');
  if(data) config=Object.fromEntries(data.map(r=>[r.chave,parseFloat(r.valor)]));
}
async function carregarEstrutura(){
  const[{data:dirs},{data:gers},{data:unis}]=await Promise.all([
    sb.from('diretorias').select('*').eq('ativo',true).order('nome'),
    sb.from('gerencias').select('*,diretorias(nome),unidades(nome)').eq('ativo',true).order('nome'),
    sb.from('unidades').select('*').eq('ativo',true).order('nome')
  ]);
  estrutura={diretorias:dirs||[],gerencias:gers||[],unidades:unis||[]};
}
async function carregarIndicadores(){
  const{data}=await sb.from('indicadores').select('*').eq('ativo',true).order('bloco').order('nome');
  indicadores=data||[];
}


function extrairEventos(lancamento) {
  const obs = lancamento.obs_auditoria || '';
  const match = obs.match(/\[ev:(.*?)\]$/s);
  if(match) {
    try { const ev=JSON.parse(match[1]); if(Array.isArray(ev)) return ev; } catch(e) {}
  }
  const t = lancamento.tipo_acidente;
  if(!t || t === 'nenhum') return [];
  const legMap = {iap:'incidente', asa:'acidente', aca:'acidente', fatalidade:'acidente'};
  return [{id:1, tipo: legMap[t]||'acidente', classe: t}];
}


function calcPontGer(itens,inds){
  let tp=0,tpo=0;
  for(const item of itens){
    const ind=inds.find(i=>i.id===item.indicador_id);
    if(!ind)continue;
    let pont=0;
    if(ind.tipo==='previsto_realizado'){const prev=parseFloat(item.previsto)||0,real=parseFloat(item.realizado)||0;pont=prev===0&&real===0?100:(prev>0?Math.min((real/prev)*100,100):0);}
    else if(ind.tipo==='nota'){pont=Math.min(parseFloat(item.nota)||0,100);}
    else if(ind.tipo==='binario'){pont=item.sim_nao?100:0;}
    tp+=ind.peso;tpo+=pont*ind.peso;item.pontuacao=pont;
  }
  return tp>0?tpo/tp:0;
}
function calcIndice(pg,md,aud,aj){
  const m=md!=null?md:pg;
  const base=pg*config.peso_gerencia+m*config.peso_diretoria+aud*config.peso_auditoria;
  return Math.max(0,Math.min(100,base+aj));
}
function getStatus(v){
  if(v>=100)return{label:'Máximo',cls:'badge-purple'};
  if(v>=(config.faixa_meta||90))return{label:'Meta',cls:'badge-green'};
  if(v>=(config.faixa_critico||80))return{label:'Mínimo',cls:'badge-yellow'};
  return{label:'Ponto de Atenção',cls:'badge-yellow'};
}

async function recalcularAuditoriaEMediaDiretoria(gerId, mes, safraId, pg) {
  const ger = estrutura.gerencias.find(g => g.id === gerId);
  let aud = 0, mediaDir = null;
  if (!ger) { console.warn('recalcularAuditoriaEMediaDiretoria: gerência ' + gerId + ' não encontrada em estrutura.gerencias'); return { aud, mediaDir }; }

  try {
    const nu = await getNotaAuditoria(ger.unidade_id, safraId);
    if (nu != null) aud = nu;
  } catch (e) { console.warn('getNotaAuditoria falhou:', e.message); }

  const gersDir = estrutura.gerencias.filter(g => g.diretoria_id === ger.diretoria_id);
  const gersIds = gersDir.map(g => g.id);

  let lancsDir = [];
  try {
    const { data, error } = await sb.from('lancamentos').select('*')
      .or('mes.eq.' + mes + ',periodo.eq.' + mes).in('gerencia_id', gersIds);
    if (error) throw error;
    lancsDir = data || [];
  } catch (e) { console.warn('recalcularAuditoriaEMediaDiretoria: busca de lançamentos da diretoria falhou:', e.message); }

  // Recalcula a pontuação de CADA gerência da diretoria a partir dos itens dela —
  // nunca confia em pontuacao_gerencia salva no banco, que pode estar desatualizada
  // ou nunca ter sido calculada (é exatamente esse o bug que gerava PONT.GER = 0
  // mesmo com item gravado). O peso de cada indicador é específico por gerência
  // (tabela ind_gerencia_safra via getIndsGerencia) — usar o peso genérico da
  // tabela indicadores dá conta errada. Cada gerência é isolada num try/catch
  // próprio, pra uma falha pontual não travar o cálculo das outras.
  const pgPorGerencia = {};
  gersDir.forEach(g => { pgPorGerencia[g.id] = 0; });
  for (const l of lancsDir) {
    if (l.gerencia_id === gerId) continue; // essa é a que acabamos de calcular (pg já veio pronto)
    try {
      const { data: itensL, error } = await sb.from('lancamento_itens').select('*').eq('lancamento_id', l.id);
      if (error) throw error;
      const indsGerL = await getIndsGerencia(l.gerencia_id, safraId);
      pgPorGerencia[l.gerencia_id] = calcPontGer(itensL || [], indsGerL || []);
    } catch (e) {
      console.warn('recalcularAuditoriaEMediaDiretoria: falhou recalcular pg da gerência ' + l.gerencia_id + ' (lançamento ' + l.id + '):', e.message);
      pgPorGerencia[l.gerencia_id] = l.pontuacao_gerencia || 0; // fallback: mantém o que já estava salvo
    }
  }
  pgPorGerencia[gerId] = pg;

  mediaDir = gersDir.length ? Object.values(pgPorGerencia).reduce((s, v) => s + v, 0) / gersDir.length : pg;

  // Propaga a pontuação recalculada + a nova média pras outras gerências da diretoria.
  for (const l of lancsDir) {
    if (l.gerencia_id === gerId) continue;
    try {
      const pgO = pgPorGerencia[l.gerencia_id];
      const nIP = calcIndice(pgO, mediaDir, l.nota_auditoria || aud, l.ajuste_pontos || 0);
      const { error } = await sb.from('lancamentos').update({ pontuacao_gerencia: pgO, media_diretoria: mediaDir, indice_prevencao: nIP }).eq('id', l.id);
      if (error) throw error;
    } catch (e) {
      console.warn('recalcularAuditoriaEMediaDiretoria: falhou atualizar lançamento ' + l.id + ' (gerência ' + l.gerencia_id + '):', e.message);
    }
  }

  return { aud, mediaDir };
}

async function getNotaAuditoria(unidadeId,safraId){
  if(!unidadeId||!safraId) return null;
  try {
    const {data} = await withTimeout(
      sb.from('auditoria_unidade').select('nota').eq('unidade_id',unidadeId).eq('safra_id',safraId).limit(1),
      8000, 'getNotaAuditoria'
    );
    return data?.[0]?.nota??null;
  } catch(e) {
    console.warn('getNotaAuditoria timeout:', e.message);
    return null;
  }
}


async function getIndsGerencia(gerId, safraId) {
  if(!gerId) return [];
  try {
    let q = sb.from('ind_gerencia_safra')
      .select('indicador_id, peso, ativo, indicadores(id, nome, tipo, fonte, bloco)')
      .eq('gerencia_id', gerId)
      .eq('ativo', true);
    if(safraId) q = q.eq('safra_id', safraId);
    const { data: cfg } = await withTimeout(q, 10000, 'getIndsGerencia');
    if(cfg && cfg.length > 0) {
      return cfg.map(r => ({...r.indicadores, peso: r.peso}));
    }
    // Fallback sem filtro de safra
    if(safraId) {
      const { data: cfgAll } = await withTimeout(
        sb.from('ind_gerencia_safra')
          .select('indicador_id, peso, ativo, indicadores(id, nome, tipo, fonte, bloco)')
          .eq('gerencia_id', gerId).eq('ativo', true),
        10000, 'getIndsGerencia fallback'
      );
      if(cfgAll && cfgAll.length > 0) {
        return cfgAll.map(r => ({...r.indicadores, peso: r.peso}));
      }
    }
  } catch(e) {
    console.warn('getIndsGerencia falhou com timeout:', e.message);
  }
  // Último fallback: indicadores base (sem query de rede)
  return indicadores.filter(i => i.base);
}



function withTimeout(promise, ms, label) {
  ms = ms || 12000;
  label = label || 'query';
  var _timer;
  var timeout = new Promise(function(_,rej){
    _timer = setTimeout(function(){ rej(new Error('Timeout: '+label+' ('+ms/1000+'s)')); }, ms);
  });
  return Promise.race([promise, timeout]).then(
    function(v){ clearTimeout(_timer); return v; },
    function(e){ clearTimeout(_timer); throw e; }
  );
}

// Wrapper com timeout obrigatorio + retry de sessao em TODA query critica
async function sbSafe(queryFn, ms){
  ms = ms || 12000;

  // ── Primeira tentativa ──
  var result;
  try {
    result = await withTimeout(queryFn(), ms, 'Supabase');
  } catch(e1) {
    console.warn('sbSafe 1a tentativa falhou:', e1.message);
    // Timeout ou falha de rede: recria cliente, renova sessao e repete
    _recrearClienteSb();
    try { await withTimeout(sb.auth.refreshSession(), 5000, 'refreshSession'); } catch(_) {}
    await new Promise(function(r){ setTimeout(r, 600); });
    try {
      result = await withTimeout(queryFn(), ms, 'Supabase retry');
    } catch(e2) {
      console.error('sbSafe retry tambem falhou:', e2.message);
      return { data: null, error: { message: e2.message } };
    }
  }

  // ── Detecta token expirado na resposta (campo .error, nao excecao) ──
  if(result && result.error) {
    var msg = (result.error.message || '').toLowerCase();
    var st  = String(result.error.status || '');
    if(msg.includes('jwt') || msg.includes('token') || msg.includes('session') || st === '401') {
      console.warn('sbSafe: token expirado na resposta, recriando cliente e renovando...');
      _recrearClienteSb();
      try { await withTimeout(sb.auth.refreshSession(), 5000, 'refreshSession'); } catch(_) {}
      await new Promise(function(r){ setTimeout(r, 600); });
      try {
        result = await withTimeout(queryFn(), ms, 'Supabase apos refresh');
      } catch(e3) {
        console.error('sbSafe falhou apos refresh:', e3.message);
        return { data: null, error: { message: e3.message } };
      }
    }
  }

  return result || { data: null, error: null };
}


