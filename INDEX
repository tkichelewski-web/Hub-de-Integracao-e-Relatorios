      // Já vem agregado por gerência (1 linha só) — soma defensiva só cobre o caso raro
      // de duas linhas pra mesma gerência/mês em arquivos diferentes (faz média nesse caso).
      grupos[chave].previsto = (grupos[chave].previsto * grupos[chave]._n + previsto) / (grupos[chave]._n + 1);
      grupos[chave].realizado = (grupos[chave].realizado * grupos[chave]._n + realizado) / (grupos[chave]._n + 1);
